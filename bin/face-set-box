#!ts
/**
 * Replace one region's display-frame box and regenerate its crop.
 *
 * A detected face's vector describes the box the detector drew. Once a human moves the box it
 * describes something else, so the region's embedding is deleted: the region keeps its person,
 * becomes a tag, and stops voting in recognition. Re-embedding the new box would ask the model
 * to find a face where a human said one is, which is the crop-embedding approach that mostly
 * came back empty (see `tag-transfer`).
 */
import type { CmdReturn, Command } from '@ein/client';
import { collectUnknownFlags, parseArgs, reportUnknownFlags } from '@ein/client';
import { resolve } from '@std/path';
import { FACE_CROP_MIMETYPE, FACE_CROP_NAME } from '@archive/media/face-crop';
import { writeFaceCrop } from '@archive/media/face-crop-rebuild';
import { clampBox, type FracBox, roundBox } from '@archive/media/orientation';
import { faceEmbeddingPathOf, imageOfRegion, REGION_TYPE } from '@archive/media/regions';
import type { FaceSetBoxResult } from '@archive/media/api';

const parseBox = (value: string | undefined): FracBox | undefined => {
  if (!value) return undefined;
  const parts = value.split(',').map(Number);
  if (parts.length !== 4 || parts.some((part) => !Number.isFinite(part))) return undefined;
  return clampBox({ x: parts[0], y: parts[1], width: parts[2], height: parts[3] });
};

const faceSetBox = async (cmd: Command): CmdReturn => {
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, {
    string: ['box'],
    boolean: ['no-crop'],
    unknown: collectUnknownFlags(unknown),
  });
  if (await reportUnknownFlags(cmd, unknown)) return 1;

  const facePath = flags._.length > 0 ? resolve(cmd.cwd, String(flags._[0])) : '';
  const sourcePath = imageOfRegion(facePath);
  if (!sourcePath) {
    await cmd.writeError('face-set-box: expected a region path directly below an image regions directory\n');
    return 1;
  }
  const box = parseBox(flags.box);
  if (!box) {
    await cmd.writeError('face-set-box: --box must be x,y,width,height fractions with positive area inside the image\n');
    return 1;
  }
  const storedBox = roundBox(box);
  const vfs = cmd.sys.vfs;
  const access = cmd.access;

  const face = await vfs.get(access, facePath, { follow: false }).catch(() => undefined);
  if (!face || face.type !== REGION_TYPE) {
    await cmd.writeError(`face-set-box: ${facePath}: not a region\n`);
    return 1;
  }
  const source = await vfs.get<{ mimetype?: string; angle?: unknown; mirror?: unknown }>(access, sourcePath).catch(() => undefined);
  if (!source || source.type !== 'file' || !String(source.attrs.mimetype ?? '').startsWith('image/')) {
    await cmd.writeError(`face-set-box: ${sourcePath}: not an image file\n`);
    return 1;
  }

  await vfs.update(access, facePath, {
    follow: false,
    attrs: {
      faceBox: storedBox,
      boxEditedAt: new Date().toISOString().replace(/\.\d+Z$/, 'Z'),
      boxEditedBy: 'face-set-box',
    },
  });
  if (await vfs.exists(access, faceEmbeddingPathOf(facePath), { follow: false })) {
    await vfs.unlink(access, faceEmbeddingPathOf(facePath), facePath);
  }

  const cropPath = `${facePath}/${FACE_CROP_NAME}`;
  if (!(await vfs.exists(access, cropPath, { follow: false }))) {
    await vfs.create(access, 'file', facePath, FACE_CROP_NAME, {
      attrs: { mimetype: FACE_CROP_MIMETYPE, sourceId: source.id },
    });
  }

  const cropError = flags['no-crop'] ? undefined : (await writeFaceCrop(cmd, sourcePath, cropPath, storedBox, source.attrs)) ?? undefined;
  const result = { faceId: face.id, facePath, box: storedBox, cropWritten: !flags['no-crop'] && !cropError, ...(cropError ? { cropError } : {}) };
  if (cmd.json) await cmd.writeJSON(result satisfies FaceSetBoxResult);
  else {
    await cmd.writeLn(`Updated ${facePath}`);
    if (flags['no-crop']) await cmd.writeLn(`Crop left for regeneration: ${cropPath}`);
    else if (cropError) await cmd.writeError(`face-set-box: crop will need regeneration: ${cropError}\n`);
  }
  return 0;
};

faceSetBox.spec = {
  name: 'face-set-box',
  effect: 'write' as const,
  description: "Change a region's box and regenerate its preview crop; a moved face stops voting in recognition",
  args: [{ name: 'face', type: 'path' as const, description: 'VFS path to a region' }],
  flags: [
    { name: 'box', type: 'string' as const, description: 'display-frame fractions: x,y,width,height' },
    { name: 'no-crop', type: 'bool' as const, description: 'leave the crop bytes for regeneration' },
  ],
  examples: [
    'face-set-box --box 0.1,0.2,0.3,0.4 /archive/albums/Exempelalbum_2019/files/IMG_0007.jpg/regions/face-1',
  ],
  returns: 'nothing; the box is changed and its crop regenerated.',
};

export default faceSetBox;
