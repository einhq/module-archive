#!ts
/**
 * track-read — read a track as drawable segments.
 *
 *   track-read <camera> [--from <iso>] [--to <iso>] [--limit <n>] [--still [--max-speed=<m/s>]] [--rejected | --only-rejected]
 *   track-read <camera> --bbox=57.8,57.6,12.1,11.8 --tolerance 0.0002 --still
 *
 * `<camera>` is a camera's slug or path, standing for its track, or a track's path.
 *
 * Output: {"segments":[{day, points:[{lat,lng,ts,...}]}], "points": n, "truncated": bool}.
 *
 * The filtering, the thinning and the cutting all happen in the registry, where
 * the spatial and time indexes are. `--tolerance` is the level of detail: about
 * the size of one screen pixel in degrees, so a zoomed-out read never ships the
 * vertices that could not be seen anyway. Segments are already cut on day
 * boundaries and on pauses, so a caller draws each one as its own line and never
 * joins across a hole the track did not travel.
 *
 * `--still` hides what the camera drew while it lay still: GPS spikes are dropped,
 * and each stay is drawn as two points on where it lay, at arrival and departure.
 * What counts as still and as a spike follows the camera's kind (`trackProfile`);
 * `--max-speed` overrides the speed above which a jump is a spike.
 *
 * The track is read without the fixes its rules rejected as it stored them — a
 * run it leapt out to faster than anything on the ground and came back from —
 * and without those a person rejected (`track-mark`). `--rejected` reads them
 * too, each marked `rejected` where the read keeps detail, with the rule's name
 * or `manual`; `--only-rejected` reads them alone, each run of them a segment of
 * its own. A fix a person gave a verdict on carries it as `manual`.
 */
import { openTrack, parseBounds, type TrackReadOptions } from '@archive/location/track';
import { trackProfile } from '@archive/location/track-profile';
import type { CmdReturn, Command } from '@ein/client';
import { collectUnknownFlags, parseArgs, reportUnknownFlags } from '@ein/client';
import type { TrackRead } from '@archive/location/api';

const trackRead = async (cmd: Command): CmdReturn => {
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, {
    string: ['from', 'to', 'limit', 'tolerance', 'bbox', 'margin', 'max-speed'],
    boolean: ['still', 'rejected', 'only-rejected'],
    unknown: collectUnknownFlags(unknown),
  });

  if (await reportUnknownFlags(cmd, unknown)) return 1;

  const target = flags._[0] as string | undefined;

  if (!target) {
    await cmd.writeError(
      'track-read: usage: track-read <camera> [--bbox <n,s,e,w>] [--from <iso>] [--to <iso>] [--tolerance <deg>] [--limit <n>] [--still [--max-speed <m/s>]] [--rejected | --only-rejected]\n',
    );
    return 1;
  }

  const numeric = (name: 'limit' | 'tolerance' | 'margin' | 'max-speed'): number | undefined => {
    if (flags[name] === undefined) return undefined;
    const value = Number(flags[name]);
    if (!Number.isFinite(value) || value < 0) {
      throw new Error(`invalid --${name} '${flags[name]}'`);
    }
    return value;
  };

  try {
    const opts: TrackReadOptions = {
      from: flags.from,
      to: flags.to,
      limit: numeric('limit'),
      tolerance: numeric('tolerance'),
      margin: numeric('margin'),
      bounds: flags.bbox !== undefined ? parseBounds(flags.bbox) : undefined,
      rejected: flags['only-rejected'] ? 'only' : flags.rejected || undefined,
    };

    if (flags['max-speed'] !== undefined && !flags.still) throw new Error('--max-speed needs --still');

    const { camera, handle } = await openTrack(cmd, target, 'r');

    try {
      if (flags.still) {
        const kind = await cmd.sys.vfs.get(cmd.access, camera).then(
          (node) => node.type === 'camera' ? (node.attrs as Record<string, unknown>).kind : undefined,
          () => undefined,
        );
        const profile = trackProfile(kind);
        opts.still = {
          radius: profile.driftRadiusM,
          minMs: profile.stillMinMs,
          stillSpeed: profile.stillMaxSpeedMps,
          maxSpeed: numeric('max-speed') ?? profile.maxSpeedMps,
        };
      }

      await cmd.writeLn(JSON.stringify((await handle.readPoints(opts)) satisfies TrackRead));
    } finally {
      await handle.close();
    }
  } catch (error) {
    await cmd.writeError(`track-read: ${error instanceof Error ? error.message : String(error)}\n`);
    return 1;
  }

  return 0;
};

trackRead.spec = {
  name: 'track-read',
  effect: 'read' as const,
  description: "Read a camera's track as drawable segments ({segments, points, truncated})",
  args: [
    { name: 'camera', type: 'path' as const, description: "the camera (slug or path) whose track to read, or a track's path" },
  ],
  flags: [
    { name: 'from', type: 'string' as const, description: 'only fixes at or after this ISO timestamp' },
    { name: 'to', type: 'string' as const, description: 'only fixes before this ISO timestamp' },
    { name: 'bbox', type: 'string' as const, description: 'only points near north,south,east,west' },
    { name: 'margin', type: 'string' as const, description: 'how far outside --bbox to read, as a fraction of it (default 0.25)' },
    { name: 'tolerance', type: 'string' as const, description: 'simplification tolerance in degrees (level of detail)' },
    { name: 'limit', type: 'string' as const, description: 'max points to return' },
    { name: 'still', type: 'bool' as const, description: "drop GPS spikes and draw each stay as two points, by the camera's kind" },
    { name: 'max-speed', type: 'string' as const, description: "with --still, a jump faster than this (m/s) is a spike (default by the camera's kind)" },
    { name: 'rejected', type: 'bool' as const, description: "read the fixes the track's rules or a person rejected too, each marked 'rejected'" },
    { name: 'only-rejected', type: 'bool' as const, description: 'read the rejected fixes alone, each run of them a segment' },
  ],
};

export default trackRead;
