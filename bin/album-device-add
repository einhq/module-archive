#!ts
/**
 * album-device-add — put devices on the list of an album, whose tracks its map draws: a GPS tracker
 * carried on the trip, say, which took none of its pictures. A device taken off the list comes back;
 * one a camera of its media is linked to, never taken off, is on it already.
 *
 * A device is its name, its path under `/dev`, or a track of it.
 */

import { resolve } from '@std/path';
import { type CmdReturn, collectUnknownFlags, type Command, parseArgs, reportUnknownFlags } from '@ein/client';
import { deviceOf } from '@archive/location/track';
import { addAlbumDevice } from '@archive/media/album-devices';

const albumDeviceAdd = async (cmd: Command): CmdReturn => {
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, { unknown: collectUnknownFlags(unknown) });
  if (await reportUnknownFlags(cmd, unknown)) return 1;
  const [album, ...devices] = flags._.map(String);
  if (!album || devices.length === 0) {
    await cmd.writeError('album-device-add: expected an album and at least one device\n');
    return 1;
  }

  try {
    const albumPath = resolve(cmd.cwd, album);
    for (const target of devices) {
      const { path } = await deviceOf(cmd, target);
      const changed = await addAlbumDevice(cmd, albumPath, path);
      if (!cmd.json) await cmd.writeLn(changed ? `Added ${path}` : `${path}: already listed`);
    }
    if (cmd.json) await cmd.writeJSON({ ok: true });
    return 0;
  } catch (error) {
    await cmd.writeError(`album-device-add: ${error instanceof Error ? error.message : String(error)}\n`);
    return 1;
  }
};

albumDeviceAdd.spec = {
  name: 'album-device-add',
  effect: 'write' as const,
  description: "Put devices on an album's list, whose tracks its map draws",
  args: [
    { name: 'album', type: 'path' as const, description: 'the album' },
    { name: 'device', type: 'path' as const, variadic: true, description: 'devices: a name, a path under /dev, or a track of one' },
  ],
  flags: [],
  examples: ['album-device-add /archive/albums/Exempelalbum_2019 sailboat', 'album-device-add /archive/albums/Exempelalbum_2019 /dev/sailboat'],
};

export default albumDeviceAdd;
