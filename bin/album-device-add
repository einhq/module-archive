#!ts
/**
 * album-device-add — put devices on the list of an album, whose tracks its map draws: a GPS
 * tracker carried on the trip, say, which took none of its pictures. A device removed from the list
 * comes back; one that took some of its media and was never removed is on it already.
 *
 * A device is its path, or its slug under the devices root.
 */

import { resolve } from '@std/path';
import { type CmdReturn, collectUnknownFlags, type Command, parseArgs, reportUnknownFlags } from '@ein/client';
import { DEVICES_ROOT } from '@archive/paths';
import { addAlbumDevice } from '@archive/media/album-devices';

const devicePath = (cwd: string, arg: string): string => arg.includes('/') ? resolve(cwd, arg) : `${DEVICES_ROOT}/${arg}`;

const albumDeviceAdd = async (cmd: Command): CmdReturn => {
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, { unknown: collectUnknownFlags(unknown) });
  if (await reportUnknownFlags(cmd, unknown)) return 1;
  const [album, ...devices] = flags._.map(String);
  if (!album || devices.length === 0) {
    await cmd.writeError('album-device-add: expected an album and at least one device\n');
    return 1;
  }

  try {
    const albumPath = resolve(cmd.cwd, album);
    for (const device of devices.map((arg) => devicePath(cmd.cwd, arg))) {
      const changed = await addAlbumDevice(cmd, albumPath, device);
      if (!cmd.json) await cmd.writeLn(changed ? `Added ${device}` : `${device}: already listed`);
    }
    if (cmd.json) await cmd.writeJSON({ ok: true });
    return 0;
  } catch (error) {
    await cmd.writeError(`album-device-add: ${error instanceof Error ? error.message : String(error)}\n`);
    return 1;
  }
};

albumDeviceAdd.spec = {
  name: 'album-device-add',
  effect: 'write' as const,
  description: "Put devices on an album's list, whose tracks its map draws",
  args: [
    { name: 'album', type: 'path' as const, description: 'the album' },
    { name: 'device', type: 'path' as const, variadic: true, description: 'devices, by their path or their slug' },
  ],
  flags: [],
  examples: ['album-device-add /archive/albums/Exempelalbum_2019 gps-tracker', 'album-device-add /archive/albums/Exempelalbum_2019 /archive/devices/exempelkamera'],
};

export default albumDeviceAdd;
