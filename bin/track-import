#!ts
/**
 * track-import — import GPX track points into a track.
 *
 *   track-import <track> /uploads/trip.gpx
 *
 * `<track>` is a track's path, or what has one: a device or a camera, by its path or by its name
 * (`trackOf`).
 *
 * Reads the GPX from a VFS file node (upload via PUT /file/<path>), parses
 * <trkpt> elements (lat/lon attrs, optional <ele>/<time>) and appends those with a
 * time; a point without one is left out and counted as `untimed`.
 * Re-importing the same file appends nothing: a fix is keyed by its timestamp.
 * The file stays where it is, and a copy is kept in the track's `routes/`, linked
 * from its `sources/` (`keepRoute`); `track-stage` moves it there instead.
 */
import { keepRoute, openTrack, parseGpx, timedPoints, TRACK_ARG } from '@archive/location/track';
import { sha256Hex } from '@archive/sources';
import type { CmdReturn, Command } from '@ein/client';
import { collectUnknownFlags, parseArgs, reportUnknownFlags } from '@ein/client';
import { resolve } from '@std/path';
import { toArrayBuffer } from '@std/streams/to-array-buffer';

const trackImport = async (cmd: Command): CmdReturn => {
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, { unknown: collectUnknownFlags(unknown) });

  if (await reportUnknownFlags(cmd, unknown)) return 1;

  const target = flags._[0] as string | undefined;
  const gpxArg = flags._[1] as string | undefined;

  if (!target || !gpxArg) {
    await cmd.writeError('track-import: usage: track-import <track> <gpx-file>\n');
    return 1;
  }

  const vfs = cmd.sys.vfs;
  const access = cmd.access;
  const gpxPath = resolve(cmd.cwd, gpxArg);

  try {
    const gpxHandle = await vfs.open(access, gpxPath, { mode: 'r' });
    let bytes: Uint8Array;
    try {
      bytes = new Uint8Array(await toArrayBuffer(gpxHandle.readable));
    } finally {
      await gpxHandle.close();
    }
    const xml = new TextDecoder().decode(bytes);

    const parsed = parseGpx(xml).points;
    const { points, untimed, problem } = timedPoints(parsed);
    if (problem) {
      await cmd.writeError(`track-import: ${gpxPath}: ${problem}\n`);
      return 1;
    }

    const { path: trackPath, handle } = await openTrack(cmd, target, 'a');
    let imported: number;
    try {
      imported = await handle.appendPoints(points);
    } finally {
      await handle.close();
    }
    const source = await keepRoute(cmd, trackPath, gpxPath, await sha256Hex(bytes), { copy: true });

    if (cmd.json) {
      await cmd.writeJSON({ imported, skipped: points.length - imported, untimed, track: trackPath, source });
    } else {
      await cmd.writeLn(`Imported ${imported} points into ${trackPath}${untimed ? `, left out ${untimed} without a time` : ''}`);
    }
  } catch (error) {
    await cmd.writeError(`track-import: ${error instanceof Error ? error.message : String(error)}\n`);
    return 1;
  }

  return 0;
};

trackImport.spec = {
  name: 'track-import',
  effect: 'write' as const,
  description: "Import GPX track points into a track, keeping a copy of the file in the track's routes/",
  args: [
    { name: 'track', type: 'path' as const, description: `the track that takes the points: ${TRACK_ARG}` },
    { name: 'gpx', type: 'path' as const, description: 'VFS path to uploaded GPX file' },
  ],
  flags: [],
};

export default trackImport;
