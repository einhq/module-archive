    { name: 'near', type: 'bool' as const, description: 'duplicates, dedupe --apply: only look-alikes: the same picture in other bytes' },
    { name: 'loose-batch', type: 'string' as const, description: "init: the default category's folder that loose entries of files/ move into (default unsorted)" },
    { name: 'layout-only', type: 'bool' as const, description: 'init: make the directories and categories only; move nothing' },
    { name: 'dry-run', dryRun: true, type: 'bool' as const, description: `${DRY_RUNS.join(', ')} --refresh: say what would be done, and do none of it` },
    { name: 'create', writes: true, type: 'bool' as const, description: 'category: make it, with its directory of groups' },
    { name: 'remove', writes: true, type: 'bool' as const, description: 'category: remove it, which only an empty one other than the default can be' },
    {
