        `journal: entries per page (default 50, at most ${JOURNAL_PAGE_MAX}); duplicates: sets per page (default ${DUPLICATE_PAGE}, at most ${DUPLICATE_PAGE_MAX}); duplicates --refresh: files announced per call (default ${REFRESH_LIMIT}); dedupe --apply: copies dropped per call`,
    },
    { name: 'cursor', type: 'string' as const, description: "journal, duplicates, duplicates --refresh, dedupe --apply: go on after this one's cursor" },
    {
      name: 'refresh',
