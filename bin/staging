      description:
        'organize --queue: only for a category something waits for: changes since its last run, edits, a first run, or a week since its last full build (administrator only)',
    },
    { name: 'at', type: 'path' as const, description: 'split: the first file of the new group' },
    { name: 'new', type: 'bool' as const, description: 'regroup: the files make a new group of their own' },
    { name: 'to', type: 'string' as const, description: 'promote: the directory a new album is made in (default /archive/albums)' },
    {
      name: 'name',
      type: 'string' as const,
      description:
        "promote: the new album's title, its path made from it (default the first group's name); split, regroup --new: the new group's name; merge: the kept group's new name",
    },
    { name: 'into', type: 'path' as const, description: 'promote: file into this library album instead of a new one' },
    { name: 'share', type: 'string' as const, description: "promote: 'private' makes the new album yours alone; 'default' shares it as your new albums are" },
