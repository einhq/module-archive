      type: 'bool' as const,
      description:
        "duplicates: announce each staged media file whose duplicate finding is missing, from another inbox or for other bytes, for media-duplicates to record; takes a folder of the user's staging files (default all of them)",
    },
    { name: 'force', type: 'bool' as const, description: 'duplicates --refresh: announce every staged media file' },
