#!ts
/**
 * subject-location — the media linked to a location node (`@archive/subjects`).
 *
 * Its name is what makes it the location's: `search --subject location:<ref>` runs `subject-<kind>`, and
 * orders, intersects, pages and counts what it answers; `search --group-by location` asks it `--of` a set of
 * media, and counts the locations they have.
 */

import type { CmdReturn, Command } from '@ein/client';
import { runSubjectCommand } from '@archive/subjects';

const subjectLocationCommand = (cmd: Command): CmdReturn => runSubjectCommand(cmd, 'location');

subjectLocationCommand.spec = {
  name: 'subject-location',
  effect: 'read' as const,
  description: 'What `search --subject location:<ref>` asks: the media linked to a location node',
  args: [
    { name: 'ref', type: 'string' as const, description: 'location slug or path (repeatable)', repeatable: true },
  ],
  flags: [
    { name: 'of', type: 'path' as const, description: 'a JSON array of media ids: answer with the location each is linked to, for `search --group-by location`' },
  ],
  examples: ['JSON_OUTPUT=1 subject-location exempelstad-torget', 'JSON_OUTPUT=1 subject-location --of /tmp/ids.json'],
  returns:
    'per ref, the path of the location and its media as node ids, truncated past 20000, or why the ref names no location; with --of, their locations once each and per media id the ones it has.',
};

export default subjectLocationCommand;
