#!ts
import { PEOPLE_ROOT } from '@archive/paths';
import type { CmdReturn, Command, NodeChildEntry } from '@ein/client';
import { shq } from '@ein/client';
import { resolve } from '@std/path';
import { OWNERS_DIR, readCamera } from '@archive/camera/camera';
import type { ClockOffsetSetting } from '@archive/camera/api';
import { clockForFile } from '@archive/camera/camera-zone';
import { formatClockOffset } from '@archive/camera/clock-offset';

type OwnerInfo = {
  name: string;
  path: string;
  /** Ownership span, when the relation carries one. */
  from?: string;
  to?: string;
};

type CameraInfo = {
  path: string;
  name: string;
  make?: string;
  model?: string;
  serialNumber?: string;
  timezone?: string;
  digitizer?: boolean;
  quicktimeUtc?: boolean;
  /** How far its clock was off, oldest first; absent when nothing says it was. */
  clockOffsets?: ClockOffsetSetting[];
  description?: string;
  owners: OwnerInfo[];
};

type OwnerLinkAttrs = { relation?: { from?: string; to?: string } };

/**
 * The camera's owners, from one listing of `owners/`.
 *
 * `ls -l` carries the softlink target in `node.props.softlink` and the relation
 * dates in `node.attrs`, so the only remaining round trip is the single
 * `ls -l` of the people root that turns slugs into display names. The previous version
 * parsed bare `ls` output as objects — it always saw an array of strings, so
 * `entry.name` was undefined and no camera ever reported an owner.
 */
const readOwners = async (cmd: Command, cameraPath: string): Promise<OwnerInfo[]> => {
  const listed = await cmd.execute(`JSON_OUTPUT=1 ls -l ${shq(`${cameraPath}/${OWNERS_DIR}`)}`);
  if (listed.code !== 0) return [];

  let links: NodeChildEntry[];
  try {
    links = JSON.parse(listed.stdout) as NodeChildEntry[];
  } catch {
    return [];
  }

  const softlinks = links.filter((link) => link.node.type === 'softlink' && link.node.props.softlink);
  if (softlinks.length === 0) return [];

  const names = new Map<string, string>();
  const people = await cmd.execute(`JSON_OUTPUT=1 ls -l ${PEOPLE_ROOT}`);
  if (people.code === 0) {
    try {
      for (const person of JSON.parse(people.stdout) as NodeChildEntry[]) {
        const name = (person.node.attrs as Record<string, unknown>).name;
        if (typeof name === 'string') names.set(person.name, name);
      }
    } catch {
      // Names are a nicety; the slug is still an answer.
    }
  }

  return softlinks.map((link): OwnerInfo => {
    const relation = (link.node.attrs as OwnerLinkAttrs).relation;
    return {
      name: names.get(link.name) ?? link.name,
      path: link.node.props.softlink!,
      ...(relation?.from ? { from: relation.from } : {}),
      ...(relation?.to ? { to: relation.to } : {}),
    };
  });
};

const cameraInfo = async (cmd: Command): CmdReturn => {
  const targetPath = cmd.args[0];

  if (!targetPath) {
    await cmd.writeError('camera-info: missing camera path\n');
    return 1;
  }

  let attrs;
  try {
    attrs = await readCamera(cmd, targetPath);
  } catch (error) {
    await cmd.writeError(`camera-info: ${error instanceof Error ? error.message : String(error)}\n`);
    return 1;
  }

  const owners = await readOwners(cmd, targetPath);
  const clockOffsets = (await clockForFile(cmd, resolve(cmd.cwd, targetPath))).history.flatMap((setting): ClockOffsetSetting[] =>
    'clockOffset' in setting ? [{ seconds: setting.clockOffset, ...(setting.from > 0 ? { from: new Date(setting.from).toISOString().slice(0, 10) } : {}) }] : []
  );

  const info: CameraInfo = {
    path: targetPath,
    name: attrs.name,
    ...(attrs.make ? { make: attrs.make } : {}),
    ...(attrs.model ? { model: attrs.model } : {}),
    ...(attrs.serialNumber ? { serialNumber: attrs.serialNumber } : {}),
    ...(attrs.timezone ? { timezone: attrs.timezone } : {}),
    ...(attrs.digitizer ? { digitizer: true } : {}),
    ...(attrs.quicktimeUtc ? { quicktimeUtc: true } : {}),
    ...(clockOffsets.length > 0 ? { clockOffsets } : {}),
    ...(attrs.description ? { description: attrs.description as string } : {}),
    owners,
  };

  if (cmd.json) {
    await cmd.writeJSON(info);
    return 0;
  }

  await cmd.writeLn(`Name: ${info.name}`);
  if (info.make) await cmd.writeLn(`Make: ${info.make}`);
  if (info.model) await cmd.writeLn(`Model: ${info.model}`);
  if (info.serialNumber) await cmd.writeLn(`Serial: ${info.serialNumber}`);
  if (info.timezone) await cmd.writeLn(`Timezone: ${info.timezone}`);
  if (info.digitizer) await cmd.writeLn('Digitizer: yes');
  if (info.quicktimeUtc) await cmd.writeLn('Video times: UTC');
  for (const setting of info.clockOffsets ?? []) {
    await cmd.writeLn(`Clock off by: ${formatClockOffset(setting.seconds)}${setting.from ? ` from ${setting.from}` : ''}`);
  }
  if (info.description) await cmd.writeLn(`Description: ${info.description}`);

  if (owners.length > 0) {
    await cmd.writeLn('');
    await cmd.writeLn('Owners:');
    for (const owner of owners) {
      const span = owner.from || owner.to ? ` ${owner.from ?? '…'} – ${owner.to ?? ''}` : '';
      await cmd.writeLn(`  ${owner.name} (${owner.path})${span}`);
    }
  }

  return 0;
};

cameraInfo.spec = {
  name: 'camera-info',
  effect: 'read' as const,
  description: 'Show camera details and owners',
  args: [
    { name: 'target', type: 'path' as const, description: 'VFS path to camera node' },
  ],
  flags: [],
};

export default cameraInfo;
