#!ts
/**
 * trip-list — a device's trips and stays, as `track-trips` last derived them.
 *
 *   trip-list <device>
 *
 * `<device>` is a device's slug or path, or its track's path. Nothing is derived here: a device
 * whose trips never were has none. A stay `track-places` put at a location carries that
 * location's name as it is now. A trip made an album (`trip-album`) names it, and an album holding
 * one of the device's trips is no other trip's candidate.
 */

import { type CmdReturn, collectUnknownFlags, type Command, parseArgs, reportUnknownFlags } from '@ein/client';
import type { DeviceTrips, TripList, TripStay } from '@archive/location/api';
import { basename } from '@std/path';
import { readDeviceTrips } from '@archive/location/device-trips';
import { trackOf } from '@archive/location/track';
import { formatDistance, trackProfile } from '@archive/location/track-profile';
import { matchTrip, tripAlbums } from '@archive/media/trip-album';

/** The trips with the album each was made, and only the albums holding no trip as candidates. */
const withAlbums = async (cmd: Command, kept: DeviceTrips): Promise<DeviceTrips['trips']> => {
  const held = await tripAlbums(cmd, kept.device);
  if (held.length === 0) return kept.trips;
  const albumOf = new Map<string, string>();
  for (const album of held) {
    const trip = matchTrip(kept.trips, album.trip);
    if (trip && !albumOf.has(trip.id)) albumOf.set(trip.id, album.path);
  }
  const holding = new Set(held.map((album) => album.path));
  return kept.trips.map((trip) => {
    const album = albumOf.get(trip.id);
    return { ...trip, albums: trip.albums.filter((path) => !holding.has(path)), ...(album ? { album } : {}) };
  });
};

/** The stays, each at a location with that location's name as it is now. */
const withNames = async (cmd: Command, stays: TripStay[]): Promise<TripStay[]> => {
  const names = new Map<string, Promise<string | undefined>>();
  const nameOf = (path: string) =>
    cmd.sys.vfs.get(cmd.access, path).then(
      (node) => typeof node.attrs.name === 'string' && node.attrs.name.trim() ? node.attrs.name : basename(path),
      () => undefined,
    );
  return await Promise.all(stays.map(async (stay) => {
    if (!stay.location) return stay;
    if (!names.has(stay.location)) names.set(stay.location, nameOf(stay.location));
    const name = await names.get(stay.location);
    return name ? { ...stay, name } : stay;
  }));
};

const tripList = async (cmd: Command): CmdReturn => {
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, { unknown: collectUnknownFlags(unknown) });
  if (await reportUnknownFlags(cmd, unknown)) return 1;
  const target = flags._[0] === undefined ? undefined : String(flags._[0]);
  if (!target) {
    await cmd.writeError('trip-list: usage: trip-list <device>\n');
    return 1;
  }

  try {
    const { device } = await trackOf(cmd, target);
    const attrs = (await cmd.sys.vfs.get(cmd.access, device)).attrs;
    const { units } = trackProfile(attrs.kind);
    const zone = typeof attrs.timezone === 'string' && attrs.timezone ? { timezone: attrs.timezone } : {};
    const kept = await readDeviceTrips(cmd, device);
    const list: TripList = kept
      ? {
        device,
        computedAt: kept.computedAt,
        ...(kept.lastFix ? { lastFix: kept.lastFix } : {}),
        units,
        ...zone,
        trips: await withAlbums(cmd, kept),
        stays: await withNames(cmd, kept.stays),
      }
      : { device, units, ...zone, trips: [], stays: [] };
    if (cmd.json) {
      await cmd.writeJSON(list satisfies TripList);
    } else if (!kept) {
      await cmd.writeLn(`${device}: no trips derived yet (track-trips ${device})`);
    } else {
      for (const trip of list.trips) {
        const days = trip.days.length === 1 ? '1 day' : `${trip.days.length} days`;
        const destination = trip.destination.stay === undefined ? undefined : list.stays[trip.destination.stay]?.name;
        await cmd.writeLn(
          `${trip.id.padEnd(13)} ${days.padEnd(8)} ${formatDistance(trip.distanceM, units).padStart(9)}${trip.ongoing ? '  ongoing' : ''}${
            destination ? `  to ${destination}` : ''
          }${trip.album ? `  album ${trip.album}` : trip.albums.length ? `  maybe ${trip.albums.join(', ')}` : ''}`,
        );
      }
    }
    return 0;
  } catch (error) {
    await cmd.writeError(`trip-list: ${error instanceof Error ? error.message : String(error)}\n`);
    return 1;
  }
};

tripList.spec = {
  name: 'trip-list',
  effect: 'read' as const,
  description: "A device's trips and stays, as track-trips last derived them",
  args: [
    { name: 'device', type: 'path' as const, description: "the device (slug or path), or its track's path" },
  ],
  flags: [],
  examples: ['trip-list the-sailboat'],
};

export default tripList;
