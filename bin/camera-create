#!ts
/**
 * camera-create — register a camera or recorder.
 *
 * `--name` is the only required field. The path is derived from it when none is
 * given (`Canon EOS 5D Mark III` → `/cameras/Canon_EOS_5D_Mark_III`), which is
 * both what the legacy import produced and what a caller with a fingerprint in
 * hand — the cameras page registering a proposal — actually has.
 *
 * A timezone is checked against ICU, as `camera-update` checks it, before anything is made.
 *
 * A camera created with a fingerprint (a serial, or make and model) is linked to the media
 * already in the archive that carry it, through `camera-relink`.
 */
import type { CmdReturn, Command } from '@ein/client';
import { parseArgs, shq } from '@ein/client';
import { dirname, resolve } from '@std/path';
import { CAMERAS_ROOT, isKnownTimezone, NODE_TYPE_CAMERA, OWNERS_DIR, slugifyCameraName } from '@archive/camera/camera';
import type { RelinkResult } from '@archive/camera/api';

const cameraCreate = async (cmd: Command): CmdReturn => {
  const flags = parseArgs(cmd.args, {
    string: ['name', 'make', 'model', 'serial', 'timezone', 'description'],
    boolean: ['digitizer', 'quicktime-utc'],
    alias: { n: 'name', m: 'make', s: 'serial' },
  });

  const name = flags.name as string | undefined;
  if (!name || !name.trim()) {
    await cmd.writeError('camera-create: missing --name\n');
    return 1;
  }

  const timezone = flags.timezone as string | undefined;
  if (timezone && !isKnownTimezone(timezone)) {
    await cmd.writeError(`camera-create: unknown timezone '${timezone}' (expected an IANA name, e.g. Europe/Stockholm)\n`);
    return 1;
  }

  const given = flags._[0] as string | undefined;
  let path: string;
  if (given) {
    path = resolve(cmd.cwd, given);
  } else {
    const slug = slugifyCameraName(name);
    if (!slug) {
      await cmd.writeError(`camera-create: cannot derive a path from '${name}' — pass one explicitly\n`);
      return 1;
    }
    path = `${CAMERAS_ROOT}/${slug}`;
  }

  if (await cmd.sys.vfs.exists(cmd.access, path)) {
    await cmd.writeError(`camera-create: ${path}: already exists\n`);
    return 1;
  }

  const attrs: Record<string, unknown> = { name: name.trim() };
  if (flags.make) attrs.make = flags.make as string;
  if (flags.model) attrs.model = flags.model as string;
  if (flags.serial) attrs.serialNumber = flags.serial as string;
  if (timezone) attrs.timezone = timezone;
  if (flags.description) attrs.description = flags.description as string;
  if (flags.digitizer) attrs.digitizer = true;
  if (flags['quicktime-utc']) attrs.quicktimeUtc = true;

  const sets = Object.entries(attrs).map(([key, value]) => typeof value === 'string' ? `--as ${shq(`${key}=${value}`)}` : `--aj ${shq(`${key}=${JSON.stringify(value)}`)}`)
    .join(' ');

  const created = await cmd.execute(`mkdir -p ${shq(dirname(path))} && mknode -t ${NODE_TYPE_CAMERA} ${shq(path)} ${sets}`);
  if (created.code !== 0) {
    await cmd.writeError(`camera-create: ${path}: ${created.stderr.trim() || 'failed to create camera node'}\n`);
    return 1;
  }

  // Owner links live in their own directory, and `camera-set-owner` expects it
  // to exist — creating it here keeps a fresh camera the same shape as an
  // imported one.
  const owners = await cmd.execute(`mkdir -p ${shq(`${path}/${OWNERS_DIR}`)}`);
  if (owners.code !== 0) {
    await cmd.writeError(`camera-create: ${path}/${OWNERS_DIR}: ${owners.stderr.trim() || 'failed to create owners directory'}\n`);
    return 1;
  }

  // The files this camera took before it was registered were passed over when they were
  // indexed; registering it is when they should find it (ein/core#863).
  let relink: RelinkResult | undefined;
  if (flags.serial || (flags.make && flags.model)) {
    const linked = await cmd.execute(`JSON_OUTPUT=1 camera-relink ${shq(path)}`);
    if (linked.code !== 0) {
      await cmd.writeError(`camera-create: ${path}: registered, but existing media were not linked: ${linked.stderr.trim() || 'relink failed'}\n`);
      return 1;
    }
    relink = JSON.parse(linked.stdout) as RelinkResult;
  }

  if (cmd.json) {
    await cmd.writeJSON({ ok: true, path, ...(relink ? { relink } : {}) });
  } else {
    await cmd.writeLn(path);
    if (relink) await cmd.writeLn(`Linked ${relink.linked} file(s) and retimed ${relink.retimed}`);
  }

  return 0;
};

cameraCreate.spec = {
  name: 'camera-create',
  effect: 'write' as const,
  description: 'Create a camera node and link the media already carrying its fingerprint',
  args: [
    { name: 'target', type: 'path' as const, description: `VFS path for the camera node (default: ${CAMERAS_ROOT}/<name>)` },
  ],
  flags: [
    { name: 'name', type: 'string' as const, description: 'display name (required)' },
    { name: 'make', type: 'string' as const, description: 'manufacturer, as exif writes it' },
    { name: 'model', type: 'string' as const, description: 'model, as exif writes it' },
    { name: 'serial', type: 'string' as const, description: 'serial number (the strong match key)' },
    { name: 'timezone', type: 'string' as const, description: 'IANA timezone, e.g. Europe/Stockholm' },
    { name: 'digitizer', type: 'bool' as const, description: 'scanner whose camera dates are digitisation times, not capture times' },
    { name: 'quicktime-utc', type: 'bool' as const, description: "keeps its videos' QuickTime CreateDate in UTC (phones), not local time" },
    { name: 'description', type: 'string' as const, description: 'free-text note' },
  ],
};

export default cameraCreate;
