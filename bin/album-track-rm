#!ts
/**
 * album-track-rm — take tracks off the list of an album, which its map draws. A track a camera of
 * its media records into stays off as more of its media joins, until `album-track-add` puts it back.
 *
 * A track is its path, or a device or camera that has one, by its path or its name (`trackOf`).
 */

import { resolve } from '@std/path';
import { type CmdReturn, collectUnknownFlags, type Command, parseArgs, reportUnknownFlags } from '@ein/client';
import { TRACK_ARG, trackOf } from '@archive/location/track';
import { removeAlbumTrack } from '@archive/media/album-tracks';

const albumTrackRm = async (cmd: Command): CmdReturn => {
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, { unknown: collectUnknownFlags(unknown) });
  if (await reportUnknownFlags(cmd, unknown)) return 1;
  const [album, ...tracks] = flags._.map(String);
  if (!album || tracks.length === 0) {
    await cmd.writeError('album-track-rm: expected an album and at least one track\n');
    return 1;
  }

  try {
    const albumPath = resolve(cmd.cwd, album);
    for (const target of tracks) {
      const { path } = await trackOf(cmd, target);
      const changed = await removeAlbumTrack(cmd, albumPath, path);
      if (!cmd.json) await cmd.writeLn(changed ? `Removed ${path}` : `${path}: not listed`);
    }
    if (cmd.json) await cmd.writeJSON({ ok: true });
    return 0;
  } catch (error) {
    await cmd.writeError(`album-track-rm: ${error instanceof Error ? error.message : String(error)}\n`);
    return 1;
  }
};

albumTrackRm.spec = {
  name: 'album-track-rm',
  effect: 'write' as const,
  description: "Take tracks off an album's list, which its map draws",
  args: [
    { name: 'album', type: 'path' as const, description: 'the album' },
    { name: 'track', type: 'path' as const, variadic: true, description: `tracks: ${TRACK_ARG}` },
  ],
  flags: [],
  examples: ['album-track-rm /archive/albums/Exempelalbum_2019 sailboat', 'album-track-rm /archive/albums/Exempelalbum_2019 /archive/devices/sailboat/position/history'],
};

export default albumTrackRm;
