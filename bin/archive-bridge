#!ts
/**
 * archive-bridge — turns VFS mutations into the archive's domain facts.
 *
 * Owns a durable queue bound to the handful of VFS routing keys the media and
 * location rules care about, applies `@archive/event-rules`, and writes the
 * resulting facts to /dev/events for the pipeline engine to trigger on: a media
 * file to index or a stage of it done, an album whose members changed, a location
 * whose position may be out of date, a photo point that may belong to a location.
 * A fact about a file in a staging category of the bulk lane says so (`lane: 'bulk'`), and
 * the work it starts runs below everything else.
 *
 * The bridge is the only emitter of those facts. Steps stay dumb: they write to
 * the VFS and the fact follows from what they wrote, so the event stream can
 * never disagree with what is actually on disk, and a gap can be filled by
 * replaying the same rules over the tree (see media-scan).
 *
 * The queue, its consumers and the delivery are the media module's bridge runner
 * (`@media/bridge`): at-least-once, a message acked only once its facts are out — which
 * includes a message nacked because one rule set failed, whose redelivery re-announces
 * what the other already published. `ARCHIVE_BRIDGE_CONCURRENCY` (default 4) consumers
 * compete on the one queue, and the rules read the node fresh, so the order they are
 * consumed in does not matter. The facts of a media file itself — it arrived, was read,
 * its renditions made — are the media module's bridge's.
 */

import { QUEUES_PATH } from '@ein/paths';
import type { CmdReturn, Command, NodeQueryCursor } from '@ein/client';
import { NodeNotFoundError } from '@ein/client';
import { nodeExists, readNode, runBridge } from '@media/bridge';
import { ARCHIVE_BRIDGE_ROUTING_KEYS, type ArchiveRuleContext, deriveArchiveEvents } from '@archive/event-rules';
import type { NodeSnapshot } from '@archive/media/event-rules';
import { SIDECAR_MIMETYPES } from '@archive/media/paired-sidecar';

/** Rows per page of the subtree query behind `unreadFilesWithin`. */
const WITHIN_PAGE = 500;

const archiveBridge = async (cmd: Command): CmdReturn => {
  const ctx: ArchiveRuleContext = {
    getNode: (path) => readNode(cmd, path),
    exists: (path) => nodeExists(cmd, path),
    // Every directory the file sits in: the parent of each path its id resolves
    // to (hard links, the file's own path included) and the parent of each
    // softlink pointing at it (a file added to an album). Both are indexed
    // reverse lookups, not walks.
    containersOf: async (filePath, nodeId) => {
      const containers = new Set<string>();
      const parentOf = (path: string): string => path.slice(0, path.lastIndexOf('/')) || '/';

      try {
        for (const path of (await cmd.sys.vfs.resolveIdPaths(cmd.access, [nodeId])).get(nodeId) ?? [filePath]) {
          containers.add(parentOf(path));
        }
        for (const link of await cmd.sys.vfs.findLinks(cmd.access, filePath)) {
          containers.add(parentOf(link.absPath));
        }
      } catch (error) {
        await cmd.writeError(`archive-bridge: ${filePath}: containers lookup failed: ${error}\n`);
      }

      return [...containers];
    },
    // An indexed subtree query, a page at a time by id, rather than a walk. A directory moved
    // and then removed before its event is read carries nothing; the error would otherwise nack
    // the event until it is dead-lettered.
    unreadFilesWithin: async (path) => {
      const files: { path: string; node: NodeSnapshot }[] = [];
      let after: NodeQueryCursor | undefined;
      for (;;) {
        let rows;
        try {
          rows = await cmd.sys.vfs.query(cmd.access, {
            within: path,
            types: ['file'],
            where: [{ ref: 'textIndexedAt', op: 'missing' }],
            after,
            limit: WITHIN_PAGE,
          });
        } catch (error) {
          if (error instanceof NodeNotFoundError) return files;
          throw error;
        }
        for (const row of rows) files.push({ path: row.absPath, node: { id: row.id, type: row.node.type, attrs: row.node.attrs as Record<string, unknown> } });
        // Fewer than a page means none are left.
        if (rows.length < WITHIN_PAGE) return files;
        after = { value: null, id: rows[rows.length - 1].id };
      }
    },
    // One indexed lookup of a single row, so a media file landing where no sidecar waits announces nothing.
    unpairedSidecarsIn: async (path) => {
      try {
        const rows = await cmd.sys.vfs.query(cmd.access, {
          within: path,
          types: ['file'],
          where: [{ ref: 'mimetype', op: 'in', value: SIDECAR_MIMETYPES }, { ref: 'sourceId', op: 'missing' }, { ref: 'sidecar', op: 'missing' }],
          limit: 1,
        });
        return rows.length > 0;
      } catch (error) {
        await cmd.writeError(`archive-bridge: ${path}: unpaired sidecar lookup failed: ${error}\n`);
        return true;
      }
    },
    getLink: async (path) => {
      try {
        const node = await cmd.sys.vfs.get(cmd.access, path, { follow: false, readlink: true });
        return { id: node.id, target: node.props.softlink, attrs: node.attrs as Record<string, unknown> };
      } catch {
        return undefined;
      }
    },
    hasPoint: async (path) => {
      try {
        const handle = await cmd.sys.vfs.open(cmd.access, path, { mode: 'r' });
        try {
          return (await handle.read(1)).length > 0;
        } finally {
          await handle.close();
        }
      } catch {
        return false;
      }
    },
  };
  return await runBridge(cmd, {
    name: 'archive-bridge',
    queuePath: cmd.env.ARCHIVE_BRIDGE_QUEUE || `${QUEUES_PATH}/archive-bridge`,
    routingKeys: ARCHIVE_BRIDGE_ROUTING_KEYS,
    concurrency: Number(cmd.env.ARCHIVE_BRIDGE_CONCURRENCY) || 4,
    derive: (event) => deriveArchiveEvents(event, ctx),
  });
};

archiveBridge.spec = {
  name: 'archive-bridge',
  effect: 'write' as const,
  description: "Derive the archive's domain events, of its media analysis, staging, albums and locations, from VFS mutations (long-running)",
  examples: [
    'archive-bridge',
  ],
  returns: "nothing; it runs until stopped, turning VFS mutations into the archive's events.",
};

export default archiveBridge;
