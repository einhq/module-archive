#!ts
/**
 * album-camera-list — the cameras whose tracks an album's map draws (`@archive/media/album-cameras`):
 * the ones that took its media, the most first, and the ones added by hand; then the cameras of its
 * media that were removed from the list.
 */

import { resolve } from '@std/path';
import { type CmdReturn, collectUnknownFlags, type Command, parseArgs, reportUnknownFlags } from '@ein/client';
import { albumCameras } from '@archive/media/album-cameras';

const albumCameraList = async (cmd: Command): CmdReturn => {
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, { unknown: collectUnknownFlags(unknown) });
  if (await reportUnknownFlags(cmd, unknown)) return 1;
  const [arg] = flags._.map(String);
  if (!arg) {
    await cmd.writeError('album-camera-list: expected an album\n');
    return 1;
  }

  try {
    const answer = await albumCameras(cmd, resolve(cmd.cwd, arg));
    if (cmd.json) {
      await cmd.writeJSON(answer);
      return 0;
    }
    if (answer.cameras.length === 0) await cmd.writeLn('No cameras');
    for (const camera of answer.cameras) {
      await cmd.writeLn(`${camera.source === 'media' ? String(camera.media).padStart(5) : 'added'}  ${camera.name}  ${camera.path}`);
    }
    if (answer.removed.length > 0) {
      await cmd.writeLn('Removed:');
      for (const camera of answer.removed) await cmd.writeLn(`${String(camera.media).padStart(5)}  ${camera.name}  ${camera.path}`);
    }
    return 0;
  } catch (error) {
    await cmd.writeError(`album-camera-list: ${error instanceof Error ? error.message : String(error)}\n`);
    return 1;
  }
};

albumCameraList.spec = {
  name: 'album-camera-list',
  effect: 'read' as const,
  description: "The cameras whose tracks an album's map draws: those that took its media and those added by hand, and the cameras of its media removed from the list",
  args: [{ name: 'album', type: 'path' as const, description: 'the album, or a folder in one' }],
  flags: [],
  examples: ['album-camera-list /archive/albums/Exempelalbum_2019', 'JSON_OUTPUT=1 album-camera-list /archive/albums/Exempelalbum_2019'],
  returns:
    "each listed camera's path and name, whether it took some of the album's media (and how many) or was added by hand; and the cameras that took some of its media but were removed from the list.",
};

export default albumCameraList;
