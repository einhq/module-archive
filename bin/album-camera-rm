#!ts
/**
 * album-camera-rm — take cameras off the list of an album, whose tracks its map draws. A camera
 * that took some of its media stays off as more of its media joins, until `album-camera-add` puts it
 * back.
 *
 * A camera is its path, or its slug under the cameras root.
 */

import { resolve } from '@std/path';
import { type CmdReturn, collectUnknownFlags, type Command, parseArgs, reportUnknownFlags } from '@ein/client';
import { CAMERAS_ROOT } from '@archive/paths';
import { removeAlbumCamera } from '@archive/media/album-cameras';

const cameraPath = (cwd: string, arg: string): string => arg.includes('/') ? resolve(cwd, arg) : `${CAMERAS_ROOT}/${arg}`;

const albumCameraRm = async (cmd: Command): CmdReturn => {
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, { unknown: collectUnknownFlags(unknown) });
  if (await reportUnknownFlags(cmd, unknown)) return 1;
  const [album, ...cameras] = flags._.map(String);
  if (!album || cameras.length === 0) {
    await cmd.writeError('album-camera-rm: expected an album and at least one camera\n');
    return 1;
  }

  try {
    const albumPath = resolve(cmd.cwd, album);
    for (const camera of cameras.map((arg) => cameraPath(cmd.cwd, arg))) {
      const changed = await removeAlbumCamera(cmd, albumPath, camera);
      if (!cmd.json) await cmd.writeLn(changed ? `Removed ${camera}` : `${camera}: not listed`);
    }
    if (cmd.json) await cmd.writeJSON({ ok: true });
    return 0;
  } catch (error) {
    await cmd.writeError(`album-camera-rm: ${error instanceof Error ? error.message : String(error)}\n`);
    return 1;
  }
};

albumCameraRm.spec = {
  name: 'album-camera-rm',
  effect: 'write' as const,
  description: "Take cameras off an album's list, whose tracks its map draws",
  args: [
    { name: 'album', type: 'path' as const, description: 'the album' },
    { name: 'camera', type: 'path' as const, variadic: true, description: 'cameras, by their path or their slug' },
  ],
  flags: [],
  examples: ['album-camera-rm /archive/albums/Exempelalbum_2019 gps-tracker', 'album-camera-rm /archive/albums/Exempelalbum_2019 /archive/cameras/exempelkamera'],
};

export default albumCameraRm;
