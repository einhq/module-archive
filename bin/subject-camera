#!ts
/**
 * subject-camera — the media a camera produced, as the attr equality the store answers (`@archive/subjects`).
 *
 * Its name is what makes it the camera's: `search --subject camera:<ref>` runs `subject-<kind>`, and
 * orders, intersects, pages and counts what it answers; `search --group-by camera` asks it `--of` a set of
 * media, and counts the cameras they have.
 */

import type { CmdReturn, Command } from '@ein/client';
import { runSubjectCommand } from '@archive/subjects';

const subjectCameraCommand = (cmd: Command): CmdReturn => runSubjectCommand(cmd, 'camera');

subjectCameraCommand.spec = {
  name: 'subject-camera',
  effect: 'read' as const,
  description: 'What `search --subject camera:<ref>` asks: the media a camera produced, as the attr equality the store answers',
  args: [
    { name: 'ref', type: 'string' as const, description: 'camera slug or path (repeatable)', repeatable: true },
  ],
  flags: [
    { name: 'of', type: 'path' as const, description: 'a JSON array of media ids: answer with the camera that took each, for `search --group-by camera`' },
  ],
  examples: ['JSON_OUTPUT=1 subject-camera Exempelkamera_X100', 'JSON_OUTPUT=1 subject-camera --of /tmp/ids.json'],
  returns:
    'per ref, the path of the camera and its media as an attr match, or why the ref names no camera; with --of, the cameras that took them once each and per media id the ones it has.',
};

export default subjectCameraCommand;
