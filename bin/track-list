#!ts
/**
 * track-list — the tracks under the archive (or under a path given), with what the track registry
 * says of each: point count, span and extent, read for all of them at once, so no track is opened.
 * A track is named as `trackName` says: its own label, or the device or camera it belongs to.
 */
import { ARCHIVE_PATH } from '@ein/paths';
import type { CmdReturn, Command } from '@ein/client';
import type { TrackEntry } from '@archive/location/api';
import { listTracks } from '@archive/location/track';
import { resolve } from '@std/path';

const trackList = async (cmd: Command): CmdReturn => {
  const within = typeof cmd.args[0] === 'string' ? resolve(cmd.cwd, cmd.args[0]) : ARCHIVE_PATH;

  let tracks: TrackEntry[];
  try {
    tracks = await listTracks(cmd, within);
  } catch (error) {
    await cmd.writeError(`track-list: ${error instanceof Error ? error.message : String(error)}\n`);
    return 1;
  }

  if (cmd.json) {
    await cmd.writeJSON(tracks satisfies TrackEntry[]);
    return 0;
  }
  for (const track of tracks) {
    await cmd.writeLn(
      `${track.name}  ${track.path}  ${track.points} points${track.firstTs ? ` ${track.firstTs.slice(0, 10)}–${(track.lastTs ?? track.firstTs).slice(0, 10)}` : ''}`,
    );
  }
  return 0;
};

trackList.spec = {
  name: 'track-list',
  effect: 'read' as const,
  description: 'List the tracks, with their name, kind, point count, span and extent',
  args: [{ name: 'within', type: 'path' as const, description: `where to look for tracks (default: ${ARCHIVE_PATH})` }],
  flags: [],
  examples: ['track-list', 'track-list /archive/devices'],
  returns: 'one row per track.',
};

export default trackList;
