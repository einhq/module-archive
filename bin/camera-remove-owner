#!ts
/**
 * camera-remove-owner — undo `camera-set-owner`.
 *
 * Removes both halves of the pair directly (`removeRelationPair`) rather than
 * unlinking one and trusting `relations-guard` to catch up: the guard is
 * asynchronous, and a caller that re-reads the person immediately afterwards —
 * which the UI does — would otherwise still see the camera it just detached.
 */
import type { CmdReturn, Command } from '@ein/client';
import { basename, resolve } from '@std/path';
import { removeRelationPair } from '@archive/people/genealogy';
import { OWNERS_DIR } from '@archive/camera/camera';

const cameraRemoveOwner = async (cmd: Command): CmdReturn => {
  const [cameraArg, personArg] = cmd.args.filter((arg) => !arg.startsWith('-'));

  if (!cameraArg || !personArg) {
    await cmd.writeError('camera-remove-owner: usage: camera-remove-owner <camera> <person>\n');
    return 1;
  }

  const camera = resolve(cmd.cwd, cameraArg);
  // The person may be given as a path or as the bare link name; both end up as
  // the same segment under owners/.
  const ownerLink = `${camera}/${OWNERS_DIR}/${basename(personArg)}`;

  try {
    await removeRelationPair(cmd.sys.vfs, cmd.access, ownerLink);
  } catch (error) {
    await cmd.writeError(`camera-remove-owner: ${ownerLink}: ${error instanceof Error ? error.message : String(error)}\n`);
    return 1;
  }

  if (cmd.json) {
    await cmd.writeJSON({ ok: true, removed: ownerLink });
  } else {
    await cmd.writeLn(`Removed owner ${basename(personArg)} from camera ${basename(camera)}`);
  }

  return 0;
};

cameraRemoveOwner.spec = {
  name: 'camera-remove-owner',
  effect: 'write' as const,
  description: 'Unlink a person from a camera (removes both halves)',
  args: [
    { name: 'camera', type: 'path' as const, description: 'VFS path to camera node' },
    { name: 'person', type: 'path' as const, description: 'VFS path to person node, or the owner link name' },
  ],
  flags: [],
};

export default cameraRemoveOwner;
