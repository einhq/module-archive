#!ts
/**
 * device-home — a device's home bases: the berths, yards and houses where arriving ends a trip.
 *
 * `add` and `rm` change the device's own list; `list` answers it, or the owners' residences when
 * the device lists none. A device is its path or its slug under the devices root, a location its
 * path or its slug under the locations root.
 */

import { resolve } from '@std/path';
import { type CmdReturn, collectUnknownFlags, type Command, parseArgs, reportUnknownFlags } from '@ein/client';
import { DEVICES_ROOT, LOCATIONS_ROOT } from '@archive/paths';
import { NODE_TYPE_DEVICE } from '@archive/device/device';
import { addDeviceHome, readDeviceHomes, removeDeviceHome } from '@archive/device/homes';
import type { DeviceHomes } from '@archive/device/api';

const ACTIONS = ['add', 'rm', 'list'];

const under = (root: string, cwd: string, arg: string): string => arg.includes('/') ? resolve(cwd, arg) : `${root}/${arg}`;

const deviceHome = async (cmd: Command): CmdReturn => {
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, { unknown: collectUnknownFlags(unknown) });
  if (await reportUnknownFlags(cmd, unknown)) return 1;
  const [deviceArg, action = 'list', ...locationArgs] = flags._.map(String);
  if (!deviceArg || !ACTIONS.includes(action) || (action !== 'list') !== (locationArgs.length > 0)) {
    await cmd.writeError('device-home: usage: device-home <device> add|rm <location>... | device-home <device> [list]\n');
    return 1;
  }

  try {
    const device = under(DEVICES_ROOT, cmd.cwd, deviceArg);
    const node = await cmd.sys.vfs.get(cmd.access, device).catch(() => {
      throw new Error(`${device}: not found`);
    });
    if (node.type !== NODE_TYPE_DEVICE) throw new Error(`${device}: not a device (${node.type})`);

    if (action === 'list') {
      const answer = (await readDeviceHomes(cmd, device)) satisfies DeviceHomes;
      if (cmd.json) {
        await cmd.writeJSON(answer);
        return 0;
      }
      if (answer.homes.length === 0) await cmd.writeLn('No home bases, and no owner with a home.');
      for (const home of answer.homes) {
        const span = home.from || home.to ? ` ${home.from ?? '…'} – ${home.to ?? ''}` : '';
        const owner = home.owner ? ` (home of ${home.owner}${span})` : '';
        await cmd.writeLn(`${home.name}  ${home.location}${owner}`);
      }
      return 0;
    }

    for (const location of locationArgs.map((arg) => under(LOCATIONS_ROOT, cmd.cwd, arg))) {
      if (action === 'add') {
        const added = await addDeviceHome(cmd, device, location);
        if (!cmd.json) await cmd.writeLn(added ? `Added ${location}` : `${location}: already a home base`);
      } else {
        const removed = await removeDeviceHome(cmd, device, location);
        if (!removed) throw new Error(`${location}: not a home base of ${device}`);
        if (!cmd.json) await cmd.writeLn(`Removed ${location}`);
      }
    }
    if (cmd.json) await cmd.writeJSON({ ok: true });
    return 0;
  } catch (error) {
    await cmd.writeError(`device-home: ${error instanceof Error ? error.message : String(error)}\n`);
    return 1;
  }
};

deviceHome.spec = {
  name: 'device-home',
  effect: 'read' as const,
  description: "List or change a device's home bases, where arriving ends a trip",
  args: [
    { name: 'device', type: 'path' as const, description: 'the device, by its path or its slug' },
    { name: 'action', type: 'choice' as const, choices: ACTIONS, writes: ['add', 'rm'], description: 'add, rm or list (the default)' },
    { name: 'location', type: 'path' as const, variadic: true, description: 'add, rm: locations, by their path or their slug' },
  ],
  flags: [],
  examples: [
    'device-home exempelbaten add Exempelhamnen',
    'device-home exempelbaten list',
    'device-home /archive/devices/exempelbaten rm /archive/locations/Exempelhamnen',
  ],
  returns: 'list: the home bases, each with its location, name, source (device, or owner with the span) and point when it has one.',
};

export default deviceHome;
