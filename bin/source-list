#!ts
/**
 * source-list — the files a node was read from: the links in its `sources/`, with what each
 * file is. A device's track lists the GPX files of its route, a person the GEDCOM files that
 * describe them.
 *
 *   source-list <node>
 */
import type { CmdReturn, Command } from '@ein/client';
import { collectUnknownFlags, parseArgs, reportUnknownFlags } from '@ein/client';
import { resolve } from '@std/path';
import { sourceFiles } from '@archive/sources';
import type { SourceFile } from '@archive/sources/api';

const sourceList = async (cmd: Command): CmdReturn => {
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, { unknown: collectUnknownFlags(unknown) });
  if (await reportUnknownFlags(cmd, unknown)) return 1;

  const target = flags._[0] as string | undefined;
  if (!target) {
    await cmd.writeError('source-list: usage: source-list <node>\n');
    return 1;
  }
  const node = resolve(cmd.cwd, target);

  try {
    await cmd.sys.vfs.get(cmd.access, node);
    const files = await sourceFiles(cmd.sys.vfs, cmd.access, node);

    if (cmd.json) {
      await cmd.writeJSON(files satisfies SourceFile[]);
    } else if (files.length === 0) {
      await cmd.writeLn(`${node}: read from no kept file`);
    } else {
      for (const file of files) await cmd.writeLn(`${file.path}${file.xref ? ` ${file.xref}` : ''}${file.missing ? ' (missing)' : ''}`);
    }
  } catch (error) {
    await cmd.writeError(`source-list: ${error instanceof Error ? error.message : String(error)}\n`);
    return 1;
  }
  return 0;
};

sourceList.spec = {
  name: 'source-list',
  effect: 'read' as const,
  description: "List the files a node was read from: the links in its sources/, such as a track's GPX files or a person's GEDCOM files",
  args: [
    { name: 'node', type: 'path' as const, description: 'the node, such as /archive/devices/<slug>/track or /archive/people/<slug>' },
  ],
  flags: [],
  examples: ['source-list /archive/devices/ruby-iphone/track', 'source-list /archive/people/ruby-wrenfield'],
  returns: 'one row per kept file: its link name, path, size, type, when written, and the GEDCOM record for a person.',
};

export default sourceList;
