#!ts
/**
 * album-device-rm — take devices off the list of an album, whose tracks its map draws. A device a
 * camera of its media is linked to stays off as more of its media joins, until `album-device-add`
 * puts it back.
 *
 * A device is its name, its path under `/dev`, or a track of it.
 */

import { resolve } from '@std/path';
import { type CmdReturn, collectUnknownFlags, type Command, parseArgs, reportUnknownFlags } from '@ein/client';
import { deviceOf } from '@archive/location/track';
import { removeAlbumDevice } from '@archive/media/album-devices';

const albumDeviceRm = async (cmd: Command): CmdReturn => {
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, { unknown: collectUnknownFlags(unknown) });
  if (await reportUnknownFlags(cmd, unknown)) return 1;
  const [album, ...devices] = flags._.map(String);
  if (!album || devices.length === 0) {
    await cmd.writeError('album-device-rm: expected an album and at least one device\n');
    return 1;
  }

  try {
    const albumPath = resolve(cmd.cwd, album);
    for (const target of devices) {
      const { path } = await deviceOf(cmd, target);
      const changed = await removeAlbumDevice(cmd, albumPath, path);
      if (!cmd.json) await cmd.writeLn(changed ? `Removed ${path}` : `${path}: not listed`);
    }
    if (cmd.json) await cmd.writeJSON({ ok: true });
    return 0;
  } catch (error) {
    await cmd.writeError(`album-device-rm: ${error instanceof Error ? error.message : String(error)}\n`);
    return 1;
  }
};

albumDeviceRm.spec = {
  name: 'album-device-rm',
  effect: 'write' as const,
  description: "Take devices off an album's list, whose tracks its map draws",
  args: [
    { name: 'album', type: 'path' as const, description: 'the album' },
    { name: 'device', type: 'path' as const, variadic: true, description: 'devices: a name, a path under /dev, or a track of one' },
  ],
  flags: [],
  examples: ['album-device-rm /archive/albums/Exempelalbum_2019 sailboat', 'album-device-rm /archive/albums/Exempelalbum_2019 /dev/sailboat'],
};

export default albumDeviceRm;
