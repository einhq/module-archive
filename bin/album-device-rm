#!ts
/**
 * album-device-rm — take devices off the list of an album, whose tracks its map draws. A device
 * that took some of its media stays off as more of its media joins, until `album-device-add` puts it
 * back.
 *
 * A device is its path, or its slug under the devices root.
 */

import { resolve } from '@std/path';
import { type CmdReturn, collectUnknownFlags, type Command, parseArgs, reportUnknownFlags } from '@ein/client';
import { DEVICES_ROOT } from '@archive/paths';
import { removeAlbumDevice } from '@archive/media/album-devices';

const devicePath = (cwd: string, arg: string): string => arg.includes('/') ? resolve(cwd, arg) : `${DEVICES_ROOT}/${arg}`;

const albumDeviceRm = async (cmd: Command): CmdReturn => {
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, { unknown: collectUnknownFlags(unknown) });
  if (await reportUnknownFlags(cmd, unknown)) return 1;
  const [album, ...devices] = flags._.map(String);
  if (!album || devices.length === 0) {
    await cmd.writeError('album-device-rm: expected an album and at least one device\n');
    return 1;
  }

  try {
    const albumPath = resolve(cmd.cwd, album);
    for (const device of devices.map((arg) => devicePath(cmd.cwd, arg))) {
      const changed = await removeAlbumDevice(cmd, albumPath, device);
      if (!cmd.json) await cmd.writeLn(changed ? `Removed ${device}` : `${device}: not listed`);
    }
    if (cmd.json) await cmd.writeJSON({ ok: true });
    return 0;
  } catch (error) {
    await cmd.writeError(`album-device-rm: ${error instanceof Error ? error.message : String(error)}\n`);
    return 1;
  }
};

albumDeviceRm.spec = {
  name: 'album-device-rm',
  effect: 'write' as const,
  description: "Take devices off an album's list, whose tracks its map draws",
  args: [
    { name: 'album', type: 'path' as const, description: 'the album' },
    { name: 'device', type: 'path' as const, variadic: true, description: 'devices, by their path or their slug' },
  ],
  flags: [],
  examples: ['album-device-rm /archive/albums/Exempelalbum_2019 gps-tracker', 'album-device-rm /archive/albums/Exempelalbum_2019 /archive/devices/exempelkamera'],
};

export default albumDeviceRm;
