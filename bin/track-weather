#!ts
/**
 * track-weather — give a camera's trips and their days the weather they had.
 *
 *   track-weather <camera> [--full] [--dry-run]
 *
 * `<camera>` is a camera's slug or path, or its track's path. For each trip `track-trips` keeps in
 * `<camera>/.trips` it samples the track once an hour, looks the weather up where the camera was at
 * each of those hours (`@archive/weather/at`), and writes a summary (`TripWeather`) on each leg and
 * one on the whole trip: the mean and the strongest wind and where it blew from, the coldest and the
 * warmest hour, and the mean cloud cover (`@archive/location/trip-weather`). Writing `.trips` writes
 * the albums made of its trips too, so the album's Trip tab shows them.
 *
 * A trip is sampled again while it lacks weather or a leg of it ended less than `SETTLE_MS` ago,
 * since the last hours may not have been observed yet; `--full` samples every trip again. A lookup
 * that fails leaves its trip as it was, and the rest of the run asks nobody; the next run asks again.
 *
 * It does nothing when `CFG_WEATHER` is `false`. The `track-trips` pipeline runs it after
 * `track-places`.
 */

import { type CmdReturn, collectUnknownFlags, type Command, parseArgs, reportUnknownFlags } from '@ein/client';
import type { CameraTrips, TrackWeather, Trip } from '@archive/location/api';
import { readCameraTrips, writeCameraTrips } from '@archive/location/camera-trips';
import { trackOf } from '@archive/location/track';
import { hourlyFixes, keepTripWeather, summarizeWeather, type WeatherFix } from '@archive/location/trip-weather';
import type { WeatherReading } from '@archive/weather/api';
import { type WeatherLookup, weatherLookupFor } from '@archive/weather/at';

/** A leg that ended this recently is sampled again: SMHI and ERA5 fill in an hour days later. */
const SETTLE_MS = 7 * 24 * 3_600_000;

type TrackReader = {
  readPoints(opts: { from?: string; to?: string }): Promise<{ segments: { points: { lat: number; lng: number; ts?: string }[] }[] }>;
  close(): Promise<void>;
};

const message = (error: unknown): string => error instanceof Error ? error.message : String(error);

/** The track's fixes from `from` to `to` (ISO), one per time, sorted. */
const fixesOf = async (handle: TrackReader, from: string, to: string): Promise<WeatherFix[]> => {
  const read = await handle.readPoints({ from, to });
  const fixes = read.segments.flatMap((segment) => segment.points.flatMap((point) => point.ts ? [{ ms: Date.parse(point.ts), lat: point.lat, lng: point.lng }] : []));
  fixes.sort((a, b) => a.ms - b.ms);
  return fixes.filter((fix, index) => index === 0 || fix.ms !== fixes[index - 1].ms);
};

/** The trip with the weather of each leg and of all of them, and how many hours that took. */
const weatherOf = async (handle: TrackReader, lookup: WeatherLookup, trip: Trip): Promise<{ trip: Trip; hours: number }> => {
  const all: WeatherReading[] = [];
  const legs = [];
  for (const leg of trip.legs) {
    const readings: WeatherReading[] = [];
    for (const hour of hourlyFixes(await fixesOf(handle, leg.start, leg.end), Date.parse(leg.start), Date.parse(leg.end))) {
      readings.push(await lookup.at(hour.lat, hour.lng, hour.ms));
    }
    all.push(...readings);
    legs.push({ ...leg, weather: summarizeWeather(readings) });
  }
  return { trip: { ...trip, legs, weather: summarizeWeather(all) }, hours: all.length };
};

const sampleTrips = async (cmd: Command, target: string, opts: { full: boolean; dryRun: boolean }): Promise<TrackWeather> => {
  const { path: trackPath, camera } = await trackOf(cmd, target);
  const result: TrackWeather = { camera, legs: 0, hours: 0, failed: 0, requests: 0 };
  const lookup = await weatherLookupFor(cmd);
  if (!lookup) return { ...result, off: true };
  const held = await readCameraTrips(cmd, camera);
  if (!held || !(await cmd.sys.vfs.exists(cmd.access, trackPath))) return result;

  const now = Date.now();
  const due = (trip: Trip) => opts.full || !trip.weather || trip.legs.some((leg) => !leg.weather || now - Date.parse(leg.end) < SETTLE_MS);
  const trips: Trip[] = [];
  const handle = await cmd.sys.vfs.open(cmd.access, trackPath, { mode: 'r' }) as unknown as TrackReader;
  try {
    for (const trip of held.trips) {
      if (!due(trip) || result.error) {
        if (due(trip)) result.failed += trip.legs.length;
        trips.push(trip);
        continue;
      }
      try {
        const sampled = await weatherOf(handle, lookup, trip);
        trips.push(sampled.trip);
        result.legs += trip.legs.length;
        result.hours += sampled.hours;
      } catch (error) {
        result.error = message(error);
        result.failed += trip.legs.length;
        trips.push(trip);
      }
    }
  } finally {
    await handle.close();
  }
  result.requests = lookup.requests;
  if (!opts.dryRun && result.legs) await recordWeather(cmd, camera, trips);
  return result;
};

/**
 * Write the weather into `.trips`, read again first: `track-trips` may have written it since. A
 * trip or leg derived differently since gets none, and the next run samples it.
 */
const recordWeather = async (cmd: Command, camera: string, sampled: Trip[]): Promise<void> => {
  const current = await readCameraTrips(cmd, camera);
  if (!current) return;
  const trips = keepTripWeather(current.trips, sampled);
  if (JSON.stringify(trips) !== JSON.stringify(current.trips)) await writeCameraTrips(cmd, camera, { ...current, trips } satisfies CameraTrips);
};

const trackWeather = async (cmd: Command): CmdReturn => {
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, { boolean: ['full', 'dry-run'], unknown: collectUnknownFlags(unknown) });
  if (await reportUnknownFlags(cmd, unknown)) return 1;
  const target = flags._[0] === undefined ? undefined : String(flags._[0]);
  if (!target) {
    await cmd.writeError('track-weather: usage: track-weather <camera> [--full] [--dry-run]\n');
    return 1;
  }

  try {
    const result = await sampleTrips(cmd, target, { full: flags.full, dryRun: flags['dry-run'] });
    if (cmd.json) {
      await cmd.writeJSON(result satisfies TrackWeather);
      return 0;
    }
    if (result.off) {
      await cmd.writeLn(`${result.camera}: weather lookups are turned off; set CFG_WEATHER to true to let EiN send places and dates to SMHI and Open-Meteo`);
      return 0;
    }
    await cmd.writeLn(
      `${result.camera}: weather for ${result.legs} day${result.legs === 1 ? '' : 's'} (${result.hours} hour${result.hours === 1 ? '' : 's'})` +
        (result.failed ? `, ${result.failed} left for the next run: ${result.error}` : '') +
        `; ${result.requests} request${result.requests === 1 ? '' : 's'} to SMHI and Open-Meteo` +
        (flags['dry-run'] ? ' (dry run, nothing written)' : ''),
    );
    return 0;
  } catch (error) {
    await cmd.writeError(`track-weather: ${message(error)}\n`);
    return 1;
  }
};

trackWeather.spec = {
  name: 'track-weather',
  effect: 'write' as const,
  description: "Give a camera's trips and their days the weather along the track: wind, temperature and cloud cover",
  args: [
    { name: 'camera', type: 'path' as const, description: "the camera (slug or path), or its track's path" },
  ],
  flags: [
    { name: 'full', type: 'bool' as const, description: 'sample every trip again, not only those without weather or with a day in the last week' },
    { name: 'dry-run', dryRun: true, type: 'bool' as const, description: 'look the weather up and count it without writing .trips' },
  ],
  examples: ['track-weather the-sailboat', 'track-weather /archive/cameras/the-sailboat --full'],
  returns: 'TrackWeather: how many days and hours it sampled, how many it left for the next run and why, and how many requests it sent.',
};

export default trackWeather;
