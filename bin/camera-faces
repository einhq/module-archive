#!ts
/**
 * camera-faces — the camera-faces service: has the media service watch every camera under /dev for
 * faces, appends each face's person (or `unknown`) to the camera's `faces` log, and files each
 * face's picture under the camera's archive node, where the archive assigns it like a photo's
 * (@archive/media/camera-faces). It runs until stopped.
 */

import type { CmdReturn, Command } from '@ein/client';
import { watchCameras } from '@archive/media/camera-faces';

const cameraFaces = async (cmd: Command): CmdReturn => {
  const stopped = new Promise<void>((resolve) => cmd.onInterrupt(resolve));
  try {
    await watchCameras(cmd, stopped, (line) => cmd.writeError(`camera-faces: ${line}\n`).catch(() => {}));
  } catch (error) {
    await cmd.writeError(`camera-faces: ${error instanceof Error ? error.message : String(error)}\n`);
    return 1;
  }
  return 0;
};

cameraFaces.spec = {
  name: 'camera-faces',
  admin: true,
  daemon: true,
  effect: 'write' as const,
  json: false,
  description:
    "Have the media service watch every camera for faces, and file what it sees: the person on the camera's faces log, the face's picture under the camera (the camera-faces service)",
  examples: ['service restart camera-faces'],
};

export default cameraFaces;
