#!ts
/**
 * raw — detect camera RAW image files and report (or sort) the non-RAW file(s)
 * they are most likely related to (e.g. IMG_1234.CR2 ↔ IMG_1234.JPG).
 *
 * Detection is by mimetype (set from a RAW name at upload, and from exiftool in
 * exif-extract) or by file extension. Matching combines metadata and
 * filename: a RAW and its JPEG from the same exposure share a capture timestamp
 * (takenAt) and camera, and usually a base filename.
 *
 * Path semantics:
 *   (no path)   scan the whole library
 *   <album>     the album's members, files it links to included
 *   <directory> scan that subtree
 *   <file>      a single file: if RAW show its non-RAW partner(s); if non-RAW,
 *               show its RAW partner(s)
 *
 * Default is report-only. With --sort, each RAW whose best partner has the same
 * base name, and no other ties with it, is moved under that partner's
 * `versions/` directory as a frozen version with a sourceId (the same layout the
 * old-system importer produced): the pipeline skips it, search and albums leave
 * it out, and it stays on the durable disk tier. Softlinks to it follow it, but a
 * cover that showed it shows the partner instead. Its
 * regions are deleted, and their people tidied, so a face on the RAW no longer
 * counts beside the same face on its partner. A version of the RAW's name already
 * there is replaced when it holds the same bytes (the RAW is a copy of it, as a
 * resumed import makes), and is an error otherwise. A RAW with no such partner, or
 * with several equally-likely ones, is left as is. Sorting a non-RAW file sorts
 * the RAWs of its name that belong under it.
 *
 * Scan enumerates RAW files by their stored mimetype. Single-file mode also
 * detects by extension.
 */

import type { CmdReturn, Command, NodeChildEntry } from '@ein/client';
import { COVER_LINK_NAME, isRawExtension, isRawMimetype, parseArgs, RAW_IMAGE_MIMETYPES, setCover } from '@ein/client';
import { basename, dirname, extname, join } from '@std/path';
import type { MediaHashes, RawFileReport, RawFileSort, RawPartner, RawScanReport, RawSortOutcome, RawSortReport, RawUnmatchedReport } from '@archive/media/api';
import { albumMembers } from '@archive/media/album-members';
import { REGION_TYPE, type RegionAttrs, regionsPathOf } from '@archive/media/regions';
import { NODE_TYPE_ALBUM } from '@archive/media/types';
import { releasePerson } from '@archive/people/person';

type FileAttrsView = { mimetype?: string; takenAt?: string; cameraPath?: string; sourceId?: string } & MediaHashes;

type FileMeta = { path: string; name: string } & FileAttrsView;

type Candidate = RawPartner & { meta: FileMeta };

const SCAN_LIMIT = 1_000_000;

/** Basename without extension, lowercased — the pairing key for filename matching. */
function stem(name: string): string {
  const base = basename(name);
  const ext = extname(base);
  return base.slice(0, base.length - ext.length).toLowerCase();
}

function isRaw(meta: FileMeta): boolean {
  return isRawMimetype(meta.mimetype) || isRawExtension(meta.name);
}

function metaFrom(path: string, attrs: FileAttrsView): FileMeta {
  return {
    path,
    name: basename(path),
    mimetype: attrs.mimetype,
    takenAt: attrs.takenAt,
    cameraPath: attrs.cameraPath,
    sourceId: attrs.sourceId,
    sha256: attrs.sha256,
    sha1: attrs.sha1,
    md5: attrs.md5,
  };
}

/** Whether two files hold the same bytes, by the strongest hash both carry; never when they share none. */
function sameBytes(a: MediaHashes, b: MediaHashes): boolean {
  for (const hash of ['sha256', 'sha1', 'md5'] as const) {
    if (a[hash] && b[hash]) return a[hash] === b[hash];
  }
  return false;
}

const partnerOf = ({ path, score, reasons }: Candidate): RawPartner => ({ path, score, reasons });

/** What pairing reads besides the files paired: the originals of each capture time, and each folder's files. */
type PartnerSource = {
  sameTime(takenAt: string): FileMeta[];
  folder(dir: string): Promise<FileMeta[]>;
};

/**
 * The partner source for `targets`: the originals sharing a capture time with any of them, read in
 * one query, and each folder listed the first time a target in it asks.
 */
async function partnerSource(cmd: Command, targets: FileMeta[]): Promise<PartnerSource> {
  const times = [...new Set(targets.flatMap((t) => t.takenAt ? [t.takenAt] : []))];
  const byTime = new Map<string, FileMeta[]>();
  if (times.length > 0) {
    const rows = await cmd.sys.vfs.query(cmd.access, {
      types: ['file'],
      where: [
        { ref: 'takenAt', op: 'in', value: times },
        { ref: 'sourceId', op: 'missing' },
      ],
      limit: SCAN_LIMIT,
    });
    for (const row of rows) {
      const meta = metaFrom(row.absPath, row.node.attrs as FileAttrsView);
      byTime.set(meta.takenAt!, [...byTime.get(meta.takenAt!) ?? [], meta]);
    }
  }

  const folders = new Map<string, Promise<FileMeta[]>>();
  const list = async (dir: string): Promise<FileMeta[]> => {
    let entries: NodeChildEntry[];
    try {
      entries = await cmd.sys.vfs.children(cmd.access, dir);
    } catch {
      return [];
    }
    return entries
      .filter((entry) => entry.node.type === 'file')
      .map((entry) => metaFrom(join(dir, entry.name), entry.node.attrs as FileAttrsView));
  };

  return {
    sameTime: (takenAt) => byTime.get(takenAt) ?? [],
    folder: (dir) => {
      if (!folders.has(dir)) folders.set(dir, list(dir));
      return folders.get(dir)!;
    },
  };
}

/** Every opposite-class (RAW↔non-RAW) file likely related to `target`, best first. */
async function findPartners(source: PartnerSource, target: FileMeta): Promise<Candidate[]> {
  const targetIsRaw = isRaw(target);
  const dir = dirname(target.path);
  const targetStem = stem(target.name);

  const candidates = new Map<string, FileMeta>();

  // Metadata candidates: originals sharing the capture timestamp.
  if (target.takenAt) {
    for (const meta of source.sameTime(target.takenAt)) {
      if (meta.path !== target.path) candidates.set(meta.path, meta);
    }
  }

  // Filename candidates: siblings in the same directory with the same stem.
  for (const meta of await source.folder(dir)) {
    if (stem(meta.name) !== targetStem) continue;
    if (meta.path === target.path || candidates.has(meta.path)) continue;
    candidates.set(meta.path, meta);
  }

  const partners: Candidate[] = [];
  for (const c of candidates.values()) {
    if (c.sourceId) continue; // never pair with a rendition/version
    if (isRaw(c) === targetIsRaw) continue; // RAW pairs only with non-RAW and vice-versa

    let score = 0;
    const reasons: RawPartner['reasons'] = [];
    if (stem(c.name) === targetStem) {
      score += 100;
      reasons.push('stem');
    }
    if (dirname(c.path) === dir) {
      score += 50;
      reasons.push('dir');
    }
    if (c.takenAt && target.takenAt && c.takenAt === target.takenAt) {
      score += 40;
      reasons.push('time');
    }
    if (c.cameraPath && target.cameraPath && c.cameraPath === target.cameraPath) {
      score += 20;
      reasons.push('camera');
    }
    partners.push({ path: c.path, score, reasons, meta: c });
  }

  partners.sort((a, b) => b.score - a.score || a.path.localeCompare(b.path));
  return partners;
}

/** Delete the regions on `filePath` and tidy the people they named; returns how many went. */
async function dropRegions(cmd: Command, filePath: string): Promise<number> {
  const vfs = cmd.sys.vfs;
  const regionsPath = regionsPathOf(filePath);
  if (!await vfs.exists(cmd.access, regionsPath)) return 0;
  const entries = await vfs.children<RegionAttrs>(cmd.access, regionsPath, { follow: false });
  const regions = entries.filter((entry) => entry.node.type === REGION_TYPE);
  const gone = new Map<string, Set<string>>();
  for (const { node } of regions) {
    const personId = node.attrs.personId;
    if (personId) gone.set(personId, (gone.get(personId) ?? new Set()).add(node.id));
  }
  await vfs.unlink(cmd.access, regionsPath, filePath, { recursive: true });
  for (const [personId, ids] of gone) await releasePerson(vfs, cmd.access, personId, ids);
  return regions.length;
}

/**
 * Move a RAW under its best partner's `versions/` dir as a frozen version and drop its regions.
 * Only a partner of the same base name counts: one matched by time and folder alone is reported,
 * never sorted under. Leaves the RAW untouched when there is no such partner, or when the top
 * two tie (ambiguous).
 */
async function sortRaw(cmd: Command, source: PartnerSource, target: FileMeta): Promise<RawSortOutcome> {
  const partners = (await findPartners(source, target)).filter((p) => p.reasons.includes('stem'));
  if (partners.length === 0) return { action: 'left' };
  if (partners.length >= 2 && partners[1].score === partners[0].score) {
    return { action: 'ambiguous', partner: partners[0].path };
  }

  const best = partners[0];
  let partnerNode;
  try {
    partnerNode = await cmd.sys.vfs.get(cmd.access, best.path);
  } catch {
    return { action: 'error', partner: best.path, error: `partner not found: ${best.path}` };
  }

  const name = basename(target.path);
  const versionsDir = `${best.path}/versions`;
  const dest = `${versionsDir}/${name}`;
  // A version already there with the same bytes is this RAW filed before, and the RAW a copy of
  // it: it takes the version's place, so the softlinks to the copy follow it.
  let replace = false;
  if (await cmd.sys.vfs.exists(cmd.access, dest)) {
    const existing = await cmd.sys.vfs.get(cmd.access, dest, { follow: false });
    if (!sameBytes(target, existing.attrs as MediaHashes)) {
      return { action: 'error', partner: best.path, error: `already exists: ${dest}` };
    }
    replace = true;
  }

  try {
    // Match the importer layout: versions/ dir, then the RAW moved in and marked
    // frozen + sourceId. frozen keeps it on the durable disk tier despite sourceId,
    // and both attrs are set in one update so it is never transiently 'volatile'.
    await cmd.sys.vfs.ensure(cmd.access, 'directory', best.path, 'versions', { props: { mode: 0o770 } });
    const [moved] = await cmd.sys.vfs.renameMany(cmd.access, [{ from: target.path, to: dest }], { failIfExists: !replace, relink: true });
    if (moved.status === 'rejected') throw moved.reason;
    await cmd.sys.vfs.update(cmd.access, dest, { attrs: { sourceId: partnerNode.id, frozen: true } });
    // A cover that showed the RAW shows its partner, since the version is left out of every listing.
    for (const link of await cmd.sys.vfs.findLinks(cmd.access, dest)) {
      if (basename(link.absPath) === COVER_LINK_NAME) await setCover(cmd.sys.vfs, cmd.access, dirname(link.absPath), best.path, { attrs: link.node.attrs });
    }
    const regions = await dropRegions(cmd, dest);
    return { action: 'sorted', partner: best.path, dest, regions };
  } catch (e) {
    return { action: 'error', partner: best.path, error: e instanceof Error ? e.message : String(e) };
  }
}

async function writeSortHuman(cmd: Command, rawPath: string, outcome: RawSortOutcome): Promise<void> {
  await cmd.writeLn(rawPath);
  switch (outcome.action) {
    case 'sorted':
      await cmd.writeLn(`  sorted -> ${outcome.dest}${outcome.regions ? ` (${outcome.regions} region(s) removed)` : ''}`);
      break;
    case 'left':
      await cmd.writeLn('  left as is (no partner of the same name)');
      break;
    case 'ambiguous':
      await cmd.writeLn('  left as is (ambiguous — several equally-likely partners)');
      break;
    case 'error':
      await cmd.writeLn(`  error: ${outcome.error}`);
      break;
  }
}

async function single(cmd: Command, target: FileMeta, limit: number, sort: boolean, verbose: boolean): Promise<number> {
  if (!sort) return await report(cmd, target, limit);
  if (!isRaw(target)) {
    // The RAWs of this file's name, each sorted on its own terms: it goes under this file only
    // when this file is its best partner.
    const raws = (await findPartners(await partnerSource(cmd, [target]), target)).filter((p) => p.reasons.includes('stem')).map((p) => p.meta);
    return await sortAll(cmd, target.path, raws, verbose);
  }
  const outcome = await sortRaw(cmd, await partnerSource(cmd, [target]), target);
  if (cmd.json) await cmd.writeJSON({ path: target.path, raw: true, mimetype: target.mimetype ?? null, ...outcome } satisfies RawFileSort);
  else await writeSortHuman(cmd, target.path, outcome);
  return outcome.action === 'error' ? 1 : 0;
}

async function report(cmd: Command, target: FileMeta, limit: number): Promise<number> {
  const raw = isRaw(target);
  const partners = (await findPartners(await partnerSource(cmd, [target]), target)).slice(0, limit).map(partnerOf);

  if (cmd.json) {
    await cmd.writeJSON({ path: target.path, raw, mimetype: target.mimetype ?? null, partners } satisfies RawFileReport);
    return 0;
  }
  await cmd.writeLn(`${target.path}  (${raw ? 'RAW' : 'non-RAW'}${target.mimetype ? `, ${target.mimetype}` : ''})`);
  if (partners.length === 0) {
    await cmd.writeLn('  no partner found');
    return 0;
  }
  for (const p of partners) await cmd.writeLn(`  -> ${p.path}  (${p.reasons.join(', ')})`);
  return 0;
}

/** RAW originals (by stored mimetype, no sourceId) in a directory's tree, or the whole library. */
async function enumerateRaws(cmd: Command, within: string | null): Promise<FileMeta[]> {
  const rows = await cmd.sys.vfs.query(cmd.access, {
    types: ['file'],
    where: [
      { ref: 'mimetype', op: 'in', value: [...RAW_IMAGE_MIMETYPES] },
      { ref: 'sourceId', op: 'missing' },
    ],
    ...(within ? { within } : {}),
    limit: SCAN_LIMIT,
  });
  return rows
    .map((r) => metaFrom(r.absPath, r.node.attrs as FileAttrsView))
    .sort((a, b) => a.path.localeCompare(b.path));
}

/** An album's RAW members, where they are: a member it links to is paired in its own folder. */
async function albumRaws(cmd: Command, albumPath: string): Promise<FileMeta[]> {
  const { members } = await albumMembers(cmd, albumPath);
  return members
    .map((member) => metaFrom(member.path, member.node.attrs as FileAttrsView))
    .filter(isRaw)
    .sort((a, b) => a.path.localeCompare(b.path));
}

async function sortAll(cmd: Command, scope: string, raws: FileMeta[], verbose: boolean): Promise<number> {
  if (verbose) await cmd.writeError(`raw: sorting ${raws.length} RAW file(s) in ${scope}\n`);

  // Sorting moves only RAWs, and a RAW's partners are non-RAW files, so what the source read
  // before the first move holds for every RAW after it.
  const source = await partnerSource(cmd, raws);
  const answer: RawSortReport = { scope, count: raws.length, sorted: [], ambiguous: [], left: [], errors: [] };
  for (const r of raws) {
    const outcome = await sortRaw(cmd, source, r);
    if (outcome.action === 'sorted') answer.sorted.push({ raw: r.path, dest: outcome.dest! });
    else if (outcome.action === 'ambiguous') answer.ambiguous.push(r.path);
    else if (outcome.action === 'error') answer.errors.push({ raw: r.path, error: outcome.error! });
    else answer.left.push(r.path);
  }

  if (cmd.json) {
    await cmd.writeJSON(answer satisfies RawSortReport);
  } else {
    await cmd.writeLn(
      `${raws.length} RAW file(s): ${answer.sorted.length} sorted, ${answer.left.length} left, ${answer.ambiguous.length} ambiguous, ${answer.errors.length} error(s)`,
    );
    for (const s of answer.sorted) await cmd.writeLn(`  sorted  ${s.raw} -> ${s.dest}`);
    for (const p of answer.ambiguous) await cmd.writeLn(`  ambig   ${p}`);
    for (const e of answer.errors) await cmd.writeLn(`  error   ${e.raw}: ${e.error}`);
  }
  // Failing only when nothing moved: the API shell drops the answer of a command that exits
  // non-zero, and a partly made sort must still say what it moved.
  return answer.errors.length > 0 && answer.sorted.length === 0 ? 1 : 0;
}

async function scanReport(cmd: Command, scope: string, raws: FileMeta[], limit: number, unmatchedOnly: boolean, verbose: boolean): Promise<number> {
  if (verbose) await cmd.writeError(`raw: ${raws.length} RAW file(s) found in ${scope}\n`);

  const pairs: RawScanReport['pairs'] = [];
  const unmatched: string[] = [];
  const source = await partnerSource(cmd, raws);
  for (const r of raws) {
    const partners = (await findPartners(source, r)).slice(0, limit).map(partnerOf);
    if (partners.length === 0) unmatched.push(r.path);
    else pairs.push({ raw: r.path, mimetype: r.mimetype ?? null, partners });
  }

  if (cmd.json) {
    if (unmatchedOnly) await cmd.writeJSON({ scope, count: unmatched.length, unmatched } satisfies RawUnmatchedReport);
    else await cmd.writeJSON({ scope, count: raws.length, pairs, unmatched } satisfies RawScanReport);
    return 0;
  }

  if (unmatchedOnly) {
    if (unmatched.length === 0) {
      await cmd.writeLn('no unmatched RAW files');
      return 0;
    }
    for (const p of unmatched) await cmd.writeLn(p);
    return 0;
  }

  if (raws.length === 0) {
    await cmd.writeLn('no RAW files found');
    return 0;
  }
  for (const pair of pairs) {
    await cmd.writeLn(`${pair.raw}${pair.mimetype ? `  (${pair.mimetype})` : ''}`);
    for (const p of pair.partners) await cmd.writeLn(`  -> ${p.path}  (${p.reasons.join(', ')})`);
  }
  if (unmatched.length > 0) {
    await cmd.writeLn(`\n${unmatched.length} RAW file(s) with no partner:`);
    for (const p of unmatched) await cmd.writeLn(`  ${p}`);
  }
  return 0;
}

const raw = async (cmd: Command): CmdReturn => {
  const flags = parseArgs(cmd.args, {
    boolean: ['v', 'unmatched', 'sort'],
    string: ['n'],
  });

  const sort = flags.sort;
  const limit = flags.n !== undefined ? Number.parseInt(flags.n, 10) : 5;
  if (!Number.isInteger(limit) || limit < 1) {
    await cmd.writeError('raw: -n must be a positive integer\n');
    return 1;
  }

  const rawPath = flags._[0] as string | undefined;

  let scope = '/';
  let raws: FileMeta[];
  if (rawPath) {
    let node;
    try {
      node = await cmd.sys.vfs.get(cmd.access, rawPath);
    } catch {
      await cmd.writeError(`raw: ${rawPath}: no such node\n`);
      return 1;
    }
    if (node.type === 'file') {
      return await single(cmd, metaFrom(rawPath, node.attrs as FileAttrsView), limit, sort, flags.v);
    }
    scope = rawPath.replace(/\/+$/, '') || '/';
    raws = node.type === NODE_TYPE_ALBUM ? await albumRaws(cmd, scope) : await enumerateRaws(cmd, scope);
  } else {
    raws = await enumerateRaws(cmd, null);
  }

  return sort ? await sortAll(cmd, scope, raws, flags.v) : await scanReport(cmd, scope, raws, limit, flags.unmatched, flags.v);
};

raw.spec = {
  name: 'raw',
  effect: 'read' as const,
  description: 'Detect RAW image files and report (or --sort) the non-RAW file(s) they are related to',
  args: [
    { name: 'path', type: 'path' as const, description: 'file, album, subtree, or omit for the whole library' },
  ],
  flags: [
    {
      name: 'sort',
      writes: true,
      type: 'bool' as const,
      description:
        'move each RAW under the versions/ dir of its partner of the same name, and delete its regions; a RAW with no such partner is left as is. On a non-RAW file, sort its RAWs under it',
    },
    { name: 'n', type: 'string' as const, description: 'max partner candidates per file (default 5)' },
    { name: 'unmatched', type: 'bool' as const, description: 'scan: list only RAW files with no partner found' },
    { name: 'v', type: 'bool' as const, description: 'verbose output' },
  ],
  examples: [
    'raw /archive/albums/Exempelalbum_2019/files/DSC_0001.NEF',
    'raw --sort /archive/albums/Exempelalbum_2019',
  ],
  returns: 'the non-RAW files the RAW is related to; with --sort, what became of each RAW.',
};

export default raw;
