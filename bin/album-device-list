#!ts
/**
 * album-device-list — the devices whose tracks an album's map draws (`@archive/media/album-devices`):
 * the ones that took its media, the most first, and the ones added by hand; then the devices of its
 * media that were removed from the list.
 */

import { resolve } from '@std/path';
import { type CmdReturn, collectUnknownFlags, type Command, parseArgs, reportUnknownFlags } from '@ein/client';
import { albumDevices } from '@archive/media/album-devices';

const albumDeviceList = async (cmd: Command): CmdReturn => {
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, { unknown: collectUnknownFlags(unknown) });
  if (await reportUnknownFlags(cmd, unknown)) return 1;
  const [arg] = flags._.map(String);
  if (!arg) {
    await cmd.writeError('album-device-list: expected an album\n');
    return 1;
  }

  try {
    const answer = await albumDevices(cmd, resolve(cmd.cwd, arg));
    if (cmd.json) {
      await cmd.writeJSON(answer);
      return 0;
    }
    if (answer.devices.length === 0) await cmd.writeLn('No devices');
    for (const device of answer.devices) {
      await cmd.writeLn(`${device.source === 'media' ? String(device.media).padStart(5) : 'added'}  ${device.name}  ${device.path}`);
    }
    if (answer.removed.length > 0) {
      await cmd.writeLn('Removed:');
      for (const device of answer.removed) await cmd.writeLn(`${String(device.media).padStart(5)}  ${device.name}  ${device.path}`);
    }
    return 0;
  } catch (error) {
    await cmd.writeError(`album-device-list: ${error instanceof Error ? error.message : String(error)}\n`);
    return 1;
  }
};

albumDeviceList.spec = {
  name: 'album-device-list',
  effect: 'read' as const,
  description: "The devices whose tracks an album's map draws: those that took its media and those added by hand, and the devices of its media removed from the list",
  args: [{ name: 'album', type: 'path' as const, description: 'the album, or a folder in one' }],
  flags: [],
  examples: ['album-device-list /archive/albums/Exempelalbum_2019', 'JSON_OUTPUT=1 album-device-list /archive/albums/Exempelalbum_2019'],
  returns:
    "each listed device's path and name, whether it took some of the album's media (and how many) or was added by hand; and the devices that took some of its media but were removed from the list.",
};

export default albumDeviceList;
