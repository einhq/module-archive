#!ts
/**
 * gedcom-read — who each individual of a GEDCOM file would be if it were imported now.
 *
 *   gedcom-read <file.ged> [--match <xref>=<person>]… [--new <xref>]… [--skip <xref>]…
 *
 * Reads the file and matches its individuals to the archive's people as `gedcom-import` would,
 * with the same choices, and writes nothing. Each individual is matched to a person, made a new
 * one or left out, and comes with the people who could be them, best first; the archive's people
 * the answer names come with their own relatives, so the file's tree and the archive's can be
 * drawn as one. A staged file is read as its owner, as it would be imported.
 */
import type { CmdReturn, Command } from '@ein/client';
import { collectUnknownFlags, parseArgs, reportUnknownFlags } from '@ein/client';
import { resolve } from '@std/path';
import { choicesFromFlags, heldSource, importerOf, planGedcom, readGedcomAt } from '@archive/people/gedcom-import';
import type { GedcomPlan } from '@archive/people/api';
import { qualifiedYear } from '@archive/people/date-qualifier';

const gedcomRead = async (cmd: Command): CmdReturn => {
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, { collect: ['match', 'new', 'skip'], string: ['match', 'new', 'skip'], unknown: collectUnknownFlags(unknown) });
  if (await reportUnknownFlags(cmd, unknown)) return 1;

  const target = flags._[0] as string | undefined;
  if (!target) {
    await cmd.writeError('gedcom-read: usage: gedcom-read <file.ged> [--match <xref>=<person>]… [--new <xref>]… [--skip <xref>]…\n');
    return 1;
  }
  const vfs = cmd.sys.vfs;
  const path = resolve(cmd.cwd, target);

  try {
    const choices = choicesFromFlags(flags as { match?: string[]; new?: string[]; skip?: string[] }, cmd.cwd);
    const as = await importerOf(vfs, cmd.access, path);
    const { gedcom, sha256 } = await readGedcomAt(vfs, cmd.access, path);
    const plan = await planGedcom(vfs, as, gedcom, path, await heldSource(vfs, as, path, sha256), choices);

    if (cmd.json) {
      await cmd.writeJSON(plan satisfies GedcomPlan);
      return 0;
    }
    for (const indi of plan.individuals) {
      const span = indi.born || indi.died ? `${qualifiedYear(indi.born, indi.bornQualifier)}–${qualifiedYear(indi.died, indi.diedQualifier)}` : '';
      const who = indi.action === 'match' ? `= ${indi.person} (${indi.how})` : indi.action === 'new' ? 'new' : 'left out';
      await cmd.writeLn(`${indi.xref} ${indi.name}${span ? ` ${span}` : ''} ${who}${indi.chosen ? ', chosen' : ''}`);
      for (const fit of indi.candidates.filter((fit) => fit.person !== indi.person)) {
        await cmd.writeLn(`    could be ${fit.person} (${fit.score}${fit.loose ? ', a like name' : ''})`);
      }
    }
  } catch (error) {
    await cmd.writeError(`gedcom-read: ${error instanceof Error ? error.message : String(error)}\n`);
    return 1;
  }
  return 0;
};

gedcomRead.spec = {
  name: 'gedcom-read',
  effect: 'read' as const,
  description:
    'Read a GEDCOM file and say who each of its individuals would be if it were imported now: matched to a person, made one or left out, with the people who could be them',
  args: [
    { name: 'file', type: 'path' as const, description: 'the GEDCOM (.ged) file' },
  ],
  flags: [
    { name: 'match', type: 'string' as const, repeatable: true, description: "who an individual is: '<xref>=<person>', as gedcom-import takes it (repeatable)" },
    { name: 'new', type: 'string' as const, repeatable: true, description: 'make the individual with this xref a new person (repeatable)' },
    { name: 'skip', type: 'string' as const, repeatable: true, description: 'leave the individual with this xref out (repeatable)' },
  ],
  examples: ['gedcom-read /home/ruby/staging/genealogy/wrenfield.ged', 'gedcom-read /home/ruby/staging/genealogy/wrenfield.ged --match @I3@=ruby-wrenfield'],
  returns:
    "each individual with their names, dates and relatives in the file, whether they would be matched, made or left out, and their candidates; and the archive's people named, with their relatives.",
};

export default gedcomRead;
