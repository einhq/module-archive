#!ts
/**
 * trip-album — make a trip of a device's track an album, or take it from the album again.
 *
 *   trip-album <device> <trip> --new [--name=<name>]
 *   trip-album <device> <trip> --album=<album>
 *   trip-album <device> <trip> --detach
 *
 * `<device>` is a device's slug or path, or its track's path; `<trip>` is a trip's id from
 * `trip-list`, or its first day. `--new` makes an album for it under the albums root, named after
 * where it got farthest when that place has a name, else after the device; the trip's days are the
 * album's span, not its name. `--album` makes an album that is there the trip's. Either writes the
 * trip as the album's attr `trip`, puts the device on the album's list (`album-device-add`) and
 * writes the album's span, which the trip widens. Whenever the device's trips are written, the album's trip is written anew from them, so
 * it grows while the trip is ongoing and gets the locations of its stays. A trip is one album's, and
 * an album holds one trip. `--detach` takes the trip off its album and leaves the device on the list.
 */

import { basename, resolve } from '@std/path';
import { type CmdReturn, collectUnknownFlags, type Command, parseArgs, reportUnknownFlags, shq } from '@ein/client';
import type { DeviceTrips, Trip } from '@archive/location/api';
import { readDeviceTrips } from '@archive/location/device-trips';
import { trackOf } from '@archive/location/track';
import { addAlbumDevice } from '@archive/media/album-devices';
import type { AlbumTrip, TripAlbumAnswer } from '@archive/media/api';
import { albumTripOf, matchTrip, TRIP_ATTR, tripAlbums, tripNamed, writeAlbumTrip } from '@archive/media/trip-album';
import { NODE_TYPE_ALBUM } from '@archive/media/types';
import { ALBUMS_ROOT } from '@archive/paths';

const USAGE = 'trip-album: usage: trip-album <device> <trip> --new [--name=<name>] | --album=<album> | --detach\n';

const nameOf = async (cmd: Command, path: string): Promise<string | undefined> => {
  const name = (await cmd.sys.vfs.get(cmd.access, path).catch(() => undefined))?.attrs.name;
  return typeof name === 'string' && name.trim() ? name.trim() : undefined;
};

/** The name a new album of the trip gets: where it got farthest, or the device. */
const defaultName = async (cmd: Command, trips: DeviceTrips, trip: Trip, deviceName: string): Promise<string> => {
  const stay = trip.destination.stay === undefined ? undefined : trips.stays[trip.destination.stay];
  const place = stay?.location && stay.kind !== 'home' ? await nameOf(cmd, stay.location) : undefined;
  return place ?? deviceName;
};

/** A path under the albums root no node has yet: `name`, else `name (2)`, `name (3)`, … */
const freeAlbumPath = async (cmd: Command, name: string): Promise<string> => {
  const slug = name.replaceAll('/', '-');
  for (let n = 1;; n++) {
    const path = `${ALBUMS_ROOT}/${n === 1 ? slug : `${slug} (${n})`}`;
    if (!(await cmd.sys.vfs.exists(cmd.access, path, { follow: false }))) return path;
  }
};

const tripAlbum = async (cmd: Command): CmdReturn => {
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, { boolean: ['new', 'detach'], string: ['album', 'name'], unknown: collectUnknownFlags(unknown) });
  if (await reportUnknownFlags(cmd, unknown)) return 1;
  const [target, name] = flags._.map(String);
  const modes = [flags.new, flags.album !== undefined, flags.detach].filter(Boolean).length;
  if (!target || !name || modes !== 1 || (flags.name !== undefined && !flags.new)) {
    await cmd.writeError(USAGE);
    return 1;
  }

  try {
    const { device } = await trackOf(cmd, target);
    const deviceAttrs = (await cmd.sys.vfs.get(cmd.access, device)).attrs as Record<string, unknown>;
    const timezone = typeof deviceAttrs.timezone === 'string' && deviceAttrs.timezone ? deviceAttrs.timezone : undefined;
    const trips = await readDeviceTrips(cmd, device);
    if (!trips) throw new Error(`${device}: no trips derived yet (track-trips ${shq(device)})`);
    const trip = tripNamed(trips.trips, name);
    if (!trip) throw new Error(`no trip ${name} (trip-list ${shq(device)})`);
    const holder = (await tripAlbums(cmd, device)).find((album) => matchTrip(trips.trips, album.trip)?.id === trip.id);

    let album: string;
    let title = '';
    if (flags.detach) {
      if (!holder) throw new Error(`trip ${trip.id} is no album's`);
      album = holder.path;
      await writeAlbumTrip(cmd, album, null);
      if (!cmd.json) await cmd.writeLn(`Took trip ${trip.id} off ${album}`);
    } else {
      if (flags.album !== undefined) {
        album = resolve(cmd.cwd, flags.album);
        const node = await cmd.sys.vfs.get(cmd.access, album);
        if (node.type !== NODE_TYPE_ALBUM) throw new Error(`${album}: not an album (is ${node.type})`);
        const held = node.attrs[TRIP_ATTR] as AlbumTrip | undefined;
        if (held && album !== holder?.path) throw new Error(`${album} holds the trip ${held.day} of ${held.device} (trip-album --detach it first)`);
      } else {
        title = flags.name?.trim() || await defaultName(cmd, trips, trip, await nameOf(cmd, device) ?? basename(device));
        album = await freeAlbumPath(cmd, title);
      }
      if (holder && holder.path !== album) throw new Error(`trip ${trip.id} is the album ${holder.path} (trip-album --detach it first)`);
      if (flags.new) {
        const created = await cmd.execute(`album create ${shq(album)} --name ${shq(title)}`);
        if (created.code !== 0) throw new Error(created.stderr.trim() || `${album}: cannot create it`);
      }
      await writeAlbumTrip(cmd, album, albumTripOf(device, timezone, trip, trips.stays));
      await addAlbumDevice(cmd, album, device);
      if (!cmd.json) await cmd.writeLn(`${flags.new ? 'Made' : 'Gave'} ${album} the trip ${trip.id}`);
    }
    if (cmd.json) await cmd.writeJSON({ album } satisfies TripAlbumAnswer);
    return 0;
  } catch (error) {
    await cmd.writeError(`trip-album: ${error instanceof Error ? error.message : String(error)}\n`);
    return 1;
  }
};

tripAlbum.spec = {
  name: 'trip-album',
  effect: 'write' as const,
  description: "Make a trip of a device's track an album, a new one or one that is there, or take it from its album",
  args: [
    { name: 'device', type: 'path' as const, description: "the device (slug or path), or its track's path" },
    { name: 'trip', type: 'string' as const, description: 'the trip: its id from trip-list, or its first day' },
  ],
  flags: [
    { name: 'new', type: 'bool' as const, description: 'make a new album of the trip' },
    { name: 'name', type: 'string' as const, description: "the new album's name; by default where the trip got farthest, or the device" },
    { name: 'album', type: 'path' as const, description: 'make this album the album of the trip' },
    { name: 'detach', type: 'bool' as const, description: 'take the trip off its album' },
  ],
  examples: [
    'trip-album the-sailboat 2025-06-10 --new',
    'trip-album the-sailboat 2025-06-10 --album=/archive/albums/Exempelalbum_2019',
    'trip-album the-sailboat 2025-06-10 --detach',
  ],
  returns: 'the album the trip was made, or the one it was taken from',
};

export default tripAlbum;
