#!ts
import { resolve } from '@std/path';
import type { CmdReturn, Command } from '@ein/client';
import { collectUnknownFlags, parseArgs, reportUnknownFlags, shq, STEP_EXIT_INPUT, STEP_EXIT_TEMPORARY } from '@ein/client';
import { audioFileName, imageFileName, imageRolesOf, type RenditionKind, type RenditionTable, storyboardFileName, videoFileName } from '@ein/api';
import { readRenditionTable } from '@ein/client';
import { EmsError, generations, stepExitCode } from '@ems/client';
import { UNDECODABLE_ATTR } from '@archive/media/media-probe';
import { TRANSCODE_REFUSED_ATTR, type TranscodeRefusal } from '@archive/media/event-rules';
import { rebuildFaceCrops } from '@archive/media/face-crop-rebuild';
import { generateImageLadder, type ImageLadderTarget } from '@archive/media/image-ladder';
import { type Dims, pictureDims } from '@archive/media/orientation';
import { type StoryboardSpec, writeStoryboard } from '@archive/media/storyboard';
import { type AudioRendition, type VideoRendition, writeTranscode } from '@archive/media/transcode';
import { reportUnwritable } from '@archive/media/writable';

type MediaType = 'image' | 'video' | 'audio';

/** The rendition table's kind for a media type. */
const KIND_OF: Record<MediaType, RenditionKind> = { image: 'photo', video: 'video', audio: 'audio' };

type DerivativeClass = 'still' | 'transcode' | 'preview' | 'storyboard';

/**
 * A rendition this command makes, by the role the rendition table (`/etc/renditions.yaml`) names
 * it under, and the class of work it is.
 *
 * The class is the cost of the work, not the media type. `still` writes AVIF pictures for every
 * type — a photo's sizes and face crops, a video's poster frames, a recording's waveform — and is
 * run by `media-stills`. `transcode` re-encodes a whole video or audio stream and can run for
 * minutes; `media-transcode` runs it. They are separate pipelines so a failed transcode does not
 * take the poster frame down with it, and so the expensive class can be serialised on its own
 * resource queue. `preview`, a video's hover clip, is a re-encode too, but it starts where the
 * poster frame was taken (`posterAt`), so `media-stills` runs it after the poster frames;
 * `media-transcode` makes it again only when forced, as on a turn. `storyboard` decodes a video's
 * whole `playback` rendition, so it is run after the transcode, in `media-transcode`; not `still`,
 * which turning a video re-makes inline (`file-set-orientation`).
 */
type Target =
  | { role: string; kind: 'image' | 'video' | 'audio'; class: DerivativeClass }
  /**
   * The face crops under `regions/<region>/image.avif`. Not a role of the table: there is one per
   * detected face, its geometry comes from that face's stored box, and it lands beside the face
   * node instead of under `thumbnails/`. It belongs among the targets anyway, because they are
   * what a `regenerate` sweep walks — a crop in none of them has a repair sweep that can find it
   * and nothing that can rebuild it, which made every interrupted write permanent.
   */
  | { role: 'face'; kind: 'face'; class: DerivativeClass }
  /**
   * A video's storyboard sheet under `thumbnails/`, its frames tiled for the player's timeline
   * (`@archive/media/storyboard`). Named by its tile rather than a box, and made from the `playback`
   * rendition rather than from the source, so it waits for that.
   */
  | { role: 'storyboard'; kind: 'storyboard'; class: DerivativeClass };

/**
 * Every rendition a file of `mediaType` gets: the table's image roles made of its kind (a photo's
 * sizes, a video's poster frames, a recording's waveform), a photo's and a video's face crops, a
 * video's `preview` clip and other video roles, its storyboard, and a recording's audio roles.
 *
 * `media-scan` counts the transcoded renditions by extension (`@archive/media/event-rules`), from
 * the same table.
 */
const targetsOf = (table: RenditionTable, mediaType: MediaType): Target[] => {
  const targets: Target[] = imageRolesOf(table, KIND_OF[mediaType]).map((role) => ({ role, kind: 'image', class: 'still' }));
  // A crop is a few hundred pixels out of a raster that is already open, so it costs about what
  // one still size does. Photos and videos: `detect-faces` refuses anything else, so no other media
  // type has a `regions/` directory.
  if (mediaType !== 'audio') targets.push({ role: 'face', kind: 'face', class: 'still' });
  if (mediaType === 'video') {
    for (const role of Object.keys(table.video)) targets.push({ role, kind: 'video', class: role === 'preview' ? 'preview' : 'transcode' });
    if (table.storyboard && table.video.playback) targets.push({ role: 'storyboard', kind: 'storyboard', class: 'storyboard' });
  }
  if (mediaType === 'audio') {
    for (const role of Object.keys(table.audio)) targets.push({ role, kind: 'audio', class: 'transcode' });
  }
  return targets;
};

/** The file a role is, under `thumbnails/`. */
const fileNameOf = (table: RenditionTable, target: Target): string | undefined => {
  if (target.kind === 'image') return table.image[target.role] && imageFileName(table.image[target.role]);
  if (target.kind === 'video') return table.video[target.role] && videoFileName(table.video[target.role]);
  if (target.kind === 'audio') return table.audio[target.role] && audioFileName(table.audio[target.role]);
  if (target.kind === 'storyboard') return table.storyboard && storyboardFileName(table.storyboard);
  return undefined;
};

const DERIVATIVE_CLASSES: DerivativeClass[] = ['still', 'transcode', 'preview', 'storyboard'];

/**
 * Below this, a video gets no storyboard: the grid's hover clip shows it whole, and a timeline
 * that short has no place a frame would help find.
 */
const MIN_STORYBOARD_SECONDS = 4;

/**
 * File-node attr: the second a video's poster frame was taken at, when EMS passed over a blank
 * frame at the second asked for (ein/core#399). The hover clip starts there too. Absent for a
 * poster where it was asked for.
 */
const POSTER_AT_ATTR = 'posterAt';

/**
 * The picture a viewer sees of this source — rotation and pixel aspect applied — or undefined
 * when the node has no stored dimensions. Audio has no picture at all: its waveform is drawn
 * to fit each box rather than resized from anything.
 */
const pictureOf = (attrs: Record<string, unknown>, mediaType: MediaType): Dims | undefined => {
  if (mediaType === 'audio') return undefined;
  const width = Number(attrs.width);
  const height = Number(attrs.height);
  if (!(width > 0 && height > 0)) return undefined;
  return pictureDims(width, height, attrs.angle, attrs.sar);
};

const generateDerivatives = async (cmd: Command): CmdReturn => {
  // `string:` is what keeps `--size grid` from making `grid` the input path — the
  // flag swallows its own value, so `flags._` is only ever the real positionals.
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, {
    boolean: ['verbose', 'force', 'prune'],
    string: ['only', 'size'],
    alias: { v: 'verbose', f: 'force' },
    unknown: collectUnknownFlags(unknown),
  });

  if (await reportUnknownFlags(cmd, unknown)) return 1;

  const verbose = Boolean(flags.verbose);
  const force = Boolean(flags.force);
  const prune = Boolean(flags.prune);

  const only = flags.only;
  if (only !== undefined && !DERIVATIVE_CLASSES.includes(only as DerivativeClass)) {
    await cmd.writeError(`generate-derivatives: unknown class '${only}' (expected ${DERIVATIVE_CLASSES.join(' or ')})\n`);
    return 1;
  }

  let table: RenditionTable;
  try {
    const read = await readRenditionTable(cmd.sys.vfs);
    table = read.table;
    if (verbose) { for (const warning of read.warnings) await cmd.writeLn(`/etc/renditions.yaml: ${warning}, left out`); }
  } catch (error) {
    await cmd.writeError(`generate-derivatives: failed to read /etc/renditions.yaml: ${(error as Error).message}\n`);
    return 1;
  }

  // `--size a,b` rather than one role per run: a backfill sweep walks the whole corpus and
  // pays a find + an attrs read per file before it does any work, so adding a role should
  // not mean paying for that walk twice.
  let sizeFilter: Set<string> | undefined;
  if (flags.size !== undefined) {
    const roles = new Set(['face', 'storyboard', ...Object.keys(table.image), ...Object.keys(table.video), ...Object.keys(table.audio)]);
    const names = flags.size.split(',').map((s) => s.trim()).filter((s) => s.length > 0);
    const bad = names.filter((n) => !roles.has(n));
    if (names.length === 0 || bad.length > 0) {
      await cmd.writeError(
        `generate-derivatives: unknown role '${bad.join("', '") || flags.size}' (expected ${[...roles].join(' | ')})\n`,
      );
      return 1;
    }
    sizeFilter = new Set(names);
  }

  const inputPath = flags._.length > 0 ? resolve(cmd.cwd, String(flags._[0])) : '';

  if (!inputPath) {
    await cmd.writeError('generate-derivatives: missing file path\n');
    return 1;
  }

  const nodeInfo = await cmd.sys.vfs.get(cmd.access, inputPath).catch(() => undefined);
  if (!nodeInfo) {
    await cmd.writeError(`generate-derivatives: ${inputPath}: file not found or unreadable\n`);
    return 1;
  }
  if (nodeInfo.type !== 'file') {
    await cmd.writeError(`generate-derivatives: ${inputPath}: not a file node (is ${nodeInfo.type})\n`);
    return 1;
  }

  if (await reportUnwritable(cmd, inputPath, nodeInfo)) return 1;

  const fileAttrs = nodeInfo.attrs;
  const mimetype = typeof fileAttrs.mimetype === 'string' ? fileAttrs.mimetype : '';

  if (fileAttrs.sourceId) {
    if (verbose) await cmd.writeLn('File is itself a rendition, skipping');
    return 0;
  }

  // A source whose container `exif-extract` could not open. The pipeline trigger already skips
  // these, but a `regenerate` sweep and a hand-run of this command come in below the trigger,
  // and without the same answer here they spend a full ffmpeg per size on a file that has no
  // frame table to read. Not an error: there is nothing wrong with this run.
  //
  // `-f` still goes ahead, so bytes that have since been replaced are one forced run away from
  // renditions. Re-indexing (`exif-extract -f`) is what actually takes the mark back off.
  const undecodable = fileAttrs[UNDECODABLE_ATTR];
  if (typeof undecodable === 'string' && undecodable.length > 0 && !force) {
    if (cmd.json) {
      await cmd.writeLn(JSON.stringify({ created: [], pruned: [], failed: 0, undecodable }));
    } else {
      await cmd.writeLn(`${inputPath}: source cannot be decoded (${undecodable}), no derivative is possible`);
    }
    return 0;
  }

  const mediaType = mimetype.startsWith('image/') ? 'image' : mimetype.startsWith('video/') ? 'video' : mimetype.startsWith('audio/') ? 'audio' : undefined;
  if (!mediaType) {
    await cmd.writeError(`generate-derivatives: ${inputPath}: unsupported mimetype ${mimetype}\n`);
    return STEP_EXIT_INPUT;
  }

  // Renditions live under a thumbnails/ directory, each named after its box (`@ein/api`):
  // images/video -> <width>x<height>, audio -> <bitrate>-<sampleRate>.
  // `--under` bounds this to `thumbnails/` itself: the file is the caller's
  // premise, and rebuilding it (and its album) when it has been deleted mid-run
  // is never what a derivative writer wants.
  const destDir = `${inputPath}/thumbnails`;
  await cmd.execute(`mkdir -p --under ${shq(inputPath)} ${shq(destDir)}`);

  const created: string[] = [];
  const pruned: string[] = [];
  let failed = 0;
  // The exit code of each EMS failure: the step ends with the worst (see the end).
  const emsFailures: number[] = [];

  // Renditions this run refused, and renditions it made that a previous run had refused. Both
  // are collected across the loop and written once at the end.
  const refused = new Map<string, TranscodeRefusal>();
  const cleared = new Set<string>();
  // The budget a refusal is recorded against — EMS's, asked for once and only when a refusal
  // has to be written — so raising it there re-opens the gap without anyone clearing the attr
  // by hand. `media-scan` counts a refusal only while its signature is the one in force.
  let encodeBudget: string | null | undefined;

  const allTargets = targetsOf(table, mediaType);

  // The still pictures a source this small never needs. `contain` does not upscale, so the
  // first box the picture fits inside stores it at its own size and every larger box would
  // store the very same pixels again — an 800x600 photo would get three identical files named
  // 800, 1600 and 2560. Only with a known picture behind them: a waveform is drawn to fit each
  // box, and a file indexed before `width`/`height` were promoted keeps the full set rather
  // than guess. The rule is `imageRolesOf` in `@ein/api`, which the pages ask by too.
  const picture = pictureOf(fileAttrs, mediaType);
  const made = new Set(imageRolesOf(table, KIND_OF[mediaType], picture));
  const redundant = new Set(allTargets.filter((t) => t.kind === 'image' && !made.has(t.role)).map((t) => t.role));
  if (verbose && picture && redundant.size > 0) {
    await cmd.writeLn(`Source is ${picture.width}x${picture.height}, skipping ${[...redundant].join(', ')} (would be copies of a smaller size)`);
  }

  // Every rendition this media type should have — from the full target list, not the --only
  // subset, so `--only still --prune` cannot delete the transcode. --prune removes anything
  // else under thumbnails/, which is how a format or size change (webp -> avif, 800 -> 1600)
  // cleans up after itself, and how a size this source is too small for goes away once it has
  // been generated. Face crops are not in this set and cannot be: they live under `regions/`,
  // which --prune never walks, so their absence here costs them nothing.
  const expectedNames = new Set(
    allTargets.filter((t) => !redundant.has(t.role)).map((t) => fileNameOf(table, t)).filter((name): name is string => name !== undefined),
  );
  const storyboard = table.storyboard && table.video.playback
    ? { ...table.storyboard, from: videoFileName(table.video.playback) } satisfies StoryboardSpec & { from: string }
    : undefined;

  // A `--size` that this media type has no target for is not an error: a sweep like
  // `regenerate --size grid` runs over a mixed tree, and erroring on every audio file
  // would fail the whole crawl.
  const targets = allTargets.filter((t) => (only === undefined || t.class === only) && (sizeFilter?.has(t.role) ?? true) && !redundant.has(t.role));

  // Every still picture goes to EMS as one call — a photo's sizes from one decode, a video's
  // poster frame fitted into the same boxes, a recording's waveform drawn per box.
  const ladderTargets: ImageLadderTarget[] = [];

  for (const target of targets) {
    if (target.kind !== 'image') continue;
    const rendition = table.image[target.role];
    const outputPath = `${destDir}/${imageFileName(rendition)}`;
    if (!force) {
      const existing = await cmd.sys.vfs.get(cmd.access, outputPath).catch(() => undefined);
      if (Number(existing?.attrs.size ?? 0) > 0) {
        if (verbose) await cmd.writeLn(`${outputPath} exists, skipping (use -f to force)`);
        continue;
      }
      if (existing && verbose) await cmd.writeLn(`${outputPath} exists but is empty, regenerating`);
    }
    ladderTargets.push({ outputPath, width: rendition.width, height: rendition.height, fit: rendition.fit, quality: rendition.quality });
  }

  if (ladderTargets.length > 0) {
    try {
      if (verbose) await cmd.writeLn(`Generating ${ladderTargets.length} image size(s) from one decode...`);
      const ladder = await generateImageLadder(cmd, {
        path: inputPath,
        id: nodeInfo.id,
        mimetype,
        angle: fileAttrs.angle,
        mirror: fileAttrs.mirror,
      }, ladderTargets);
      created.push(...ladder.written);
      if (ladder.posterAt !== undefined) {
        // EMS asks for the frame a second in; a later one means that frame was blank.
        const posterAt = ladder.posterAt > 1 ? ladder.posterAt : null;
        if (posterAt !== (fileAttrs[POSTER_AT_ATTR] ?? null)) {
          await cmd.sys.vfs.update(cmd.access, inputPath, { attrs: { [POSTER_AT_ATTR]: posterAt } });
        }
      }
    } catch (error) {
      await cmd.writeError(`generate-derivatives: image ladder: ${error instanceof Error ? error.message : String(error)}\n`);
      failed += ladderTargets.length;
      emsFailures.push(...ladderTargets.map(() => stepExitCode(error)));
    }
  }

  for (const target of targets) {
    if (target.kind === 'image') continue;
    if (target.kind === 'face') {
      // Every stored box for this image, rebuilt from the image itself. Nothing here re-runs
      // detection: the box is the input, and a crop is reproducible from it forever.
      const faces = await rebuildFaceCrops(cmd, {
        source: inputPath,
        sourceId: nodeInfo.id,
        attrs: fileAttrs,
        force,
        log: verbose ? (message) => cmd.writeLn(message) : undefined,
      });
      created.push(...faces.written);
      for (const failure of faces.failed) {
        await cmd.writeError(`generate-derivatives: ${failure.path}: ${failure.reason}\n`);
        failed++;
      }
      continue;
    }

    if (target.kind === 'storyboard') {
      // A target only when the table has both, so this is a guard for the type alone.
      if (!storyboard) continue;
      const outputPath = `${destDir}/${storyboardFileName(storyboard)}`;
      const duration = Number(fileAttrs.duration);
      if (Number.isFinite(duration) && duration > 0 && duration < MIN_STORYBOARD_SECONDS) {
        if (verbose) await cmd.writeLn(`${outputPath} skipped: source is ${duration}s, shorter than a storyboard`);
        continue;
      }
      if (!force) {
        const existing = await cmd.sys.vfs.get(cmd.access, outputPath).catch(() => undefined);
        if (Number(existing?.attrs.size ?? 0) > 0) {
          if (verbose) await cmd.writeLn(`${outputPath} exists, skipping (use -f to force)`);
          continue;
        }
      }
      // Made from the rendition, so not before there is one: the transcode step runs first.
      const renditionPath = `${destDir}/${storyboard.from}`;
      const rendition = await cmd.sys.vfs.get(cmd.access, renditionPath).catch(() => undefined);
      if (!(Number(rendition?.attrs.size ?? 0) > 0)) {
        if (verbose) await cmd.writeLn(`${outputPath} skipped: ${renditionPath} is not made yet`);
        continue;
      }
      if (verbose) await cmd.writeLn(`Generating ${outputPath}...`);
      try {
        created.push((await writeStoryboard(cmd, { id: nodeInfo.id, rendition: renditionPath }, outputPath, storyboard)).made);
      } catch (error) {
        // An EMS from before the op has no route for it; the sheet waits for one that has.
        if (error instanceof EmsError && error.code === 'http_404') {
          if (verbose) await cmd.writeLn(`${outputPath} skipped: this EMS makes no storyboards`);
          continue;
        }
        await cmd.writeError(`generate-derivatives: ${outputPath}: ${error instanceof Error ? error.message : String(error)}\n`);
        // A rendition EMS cannot read will not be read on a retry either. Failing the step for it
        // would only have the pipeline run again, and a turned video's run re-encodes it first.
        const code = stepExitCode(error);
        if (code === STEP_EXIT_INPUT) continue;
        failed++;
        emsFailures.push(code);
      }
      continue;
    }

    const fileName = fileNameOf(table, target)!;
    const outputPath = `${destDir}/${fileName}`;

    // A rendition counts as present only if it has bytes. The converters create the output
    // node before running ffmpeg/convert, so a failed encode leaves a 0-byte node behind —
    // and an existence-only check then skipped it forever, making one failure permanent.
    if (!force) {
      const existing = await cmd.sys.vfs.get(cmd.access, outputPath).catch(() => undefined);
      if (existing) {
        const existingSize = Number(existing.attrs.size ?? 0);
        if (existingSize > 0) {
          if (verbose) await cmd.writeLn(`${outputPath} exists, skipping (use -f to force)`);
          continue;
        }
        if (verbose) await cmd.writeLn(`${outputPath} exists but is empty, regenerating`);
      }
    }

    let rendition: VideoRendition | AudioRendition;

    if (target.kind === 'video') {
      const videoDef = table.video[target.role];
      rendition = {
        kind: 'video',
        outputPath,
        width: videoDef.width,
        height: videoDef.height,
        crf: videoDef.crf,
        preset: videoDef.preset,
        audioBitrate: videoDef.audioBitrate,
        mute: videoDef.mute,
      };

      // A clipped rendition against a video shorter than the clip. `duration` is the
      // promoted attr, absent on anything indexed before it existed — in which case fall
      // through with the configured start, the same >=1s the poster frame already assumes.
      if (videoDef.seconds !== undefined) {
        const duration = Number(fileAttrs.duration);
        const known = Number.isFinite(duration) && duration > 0;
        // Where the poster frame is, when the frame at the configured start was blank.
        const posterAt = Number(fileAttrs[POSTER_AT_ATTR]);
        let start = Math.max(videoDef.start ?? 0, Number.isFinite(posterAt) ? posterAt : 0);

        // Nothing to preview: the poster frame already is the whole video. `MIN_PREVIEW_SECONDS`
        // in `@archive/media/event-rules` is this same threshold — without it `media-scan` would report
        // every short clip as missing a rendition it is never going to get.
        if (known && duration < 2) {
          if (verbose) await cmd.writeLn(`${outputPath} skipped: source is ${duration}s, shorter than a preview`);
          continue;
        }
        // Seeking past (or almost past) the end yields an empty clip that still has mp4
        // headers, so `size > 0` would read as success and never be retried.
        if (known && duration <= start + 2) start = 0;

        if (start > 0) rendition.start = start;
        rendition.seconds = videoDef.seconds;
      }
    } else {
      const audioDef = table.audio[target.role];
      rendition = { kind: 'audio', outputPath, bitrate: audioDef.bitrate, sampleRate: audioDef.sampleRate };
    }

    if (verbose) await cmd.writeLn(`Generating ${outputPath}...`);
    let outcome;
    try {
      outcome = await writeTranscode(cmd, {
        path: inputPath,
        id: nodeInfo.id,
        mimetype,
        angle: fileAttrs.angle,
        mirror: fileAttrs.mirror,
        // The picture codec, off the attrs already read: EMS starts one stage down for a codec
        // NVDEC cannot decode instead of spending a doomed ffmpeg per rendition. Absent on
        // anything indexed before `exif-extract` wrote it, which EMS treats as "unknown".
        ...(typeof fileAttrs.codec === 'string' && fileAttrs.codec ? { codec: fileAttrs.codec } : {}),
      }, rendition);
    } catch (error) {
      await cmd.writeError(`generate-derivatives: ${outputPath}: ${error instanceof Error ? error.message : String(error)}\n`);
      failed++;
      emsFailures.push(stepExitCode(error));
      continue;
    }

    // A refusal is not a failure. Nothing was left half-written, another attempt would refuse
    // the same way, and counting it in `failed` would fail the step and hold `--prune` off
    // forever on a file that has nothing stale to prune. Record it and carry on; the marker is
    // what closes the gap, not the exit code.
    if ('refused' in outcome) {
      if (encodeBudget === undefined) encodeBudget = (await generations(cmd))?.cpuBudget ?? null;
      refused.set(fileName, { reason: outcome.refused, budget: encodeBudget ?? '', at: Date.now() });
      await cmd.writeError(`generate-derivatives: ${outputPath}: refused: ${outcome.refused}\n`);
      continue;
    }

    created.push(outputPath);
    // Made after all — by a raised budget, a hand-run `regenerate`, or a GPU stage that was not
    // available last time. Whatever the reason, the recorded refusal is now false.
    cleared.add(fileName);
  }

  // One write, after the loop, and only when the record actually changes. `cleared` collects
  // every rendition this run made — most runs are the poster-frame pass over an image and have
  // no refusal to clear — so writing on `cleared.size > 0` alone would put a node update on the
  // hottest path in the crawl for nothing.
  const storedRefusals = fileAttrs[TRANSCODE_REFUSED_ATTR];
  const existing: Record<string, TranscodeRefusal> = storedRefusals && typeof storedRefusals === 'object' && !Array.isArray(storedRefusals) ? storedRefusals : {};
  const next: Record<string, TranscodeRefusal> = { ...existing };

  for (const name of cleared) delete next[name];
  for (const [name, refusal] of refused) next[name] = refusal;

  if (JSON.stringify(next) !== JSON.stringify(existing)) {
    // An empty map is removed rather than stored: `undecodable` reads as absent-or-set and this
    // attr should too, so `attrs` on a file that no longer refuses anything says nothing at all.
    // `null` is what removes an attr — omitting the key means "leave it alone", so `undefined`
    // here would silently keep the last refusal forever. See NodeAttrsUpdate.
    await cmd.sys.vfs.update(cmd.access, inputPath, {
      attrs: { [TRANSCODE_REFUSED_ATTR]: Object.keys(next).length > 0 ? next : null },
    });
  }

  // Drop renditions that are no longer part of the target set. Only ever runs when nothing
  // failed: a transcode that died leaves the old rendition as the only playable copy, and
  // deleting it would turn a retryable failure into a missing file.
  if (prune && failed === 0) {
    const entries = await cmd.sys.vfs.children(cmd.access, destDir);

    for (const entry of entries) {
      if (expectedNames.has(entry.name)) {
        continue;
      }

      // By path, not by node id: NodePath and NodeId are both `string`, so an id here would
      // type-check and then be resolved as a path
      const stalePath = `${destDir}/${entry.name}`;
      await cmd.sys.vfs.unlink(cmd.access, stalePath, destDir, { recursive: true });
      pruned.push(stalePath);
    }
  }

  if (cmd.json) {
    await cmd.writeLn(JSON.stringify({ created, pruned, failed }));
  } else {
    await cmd.writeLn(
      `Created ${created.length} derivative(s)${pruned.length ? `, pruned ${pruned.length}` : ''}${failed ? `, ${failed} failed` : ''}`,
    );
    for (const p of created) {
      await cmd.writeLn(`  ${p}`);
    }
    for (const p of pruned) {
      await cmd.writeLn(`  - ${p}`);
    }
  }

  if (failed === 0) return 0;
  // Only when every failure was EMS's does EMS's verdict decide: all of them temporary means
  // the step waits for EMS, and an input failure among them means the file cannot be made.
  // Any failure of the step's own (a missing size, a crop that did not write) is a failure.
  if (emsFailures.length < failed) return 1;
  if (emsFailures.includes(1)) return 1;
  return emsFailures.includes(STEP_EXIT_INPUT) ? STEP_EXIT_INPUT : STEP_EXIT_TEMPORARY;
};

generateDerivatives.spec = {
  name: 'generate-derivatives',
  effect: 'write' as const,
  description: 'Generate web derivatives (still pictures, transcoded renditions) for a media file',
  args: [
    { name: 'input', type: 'path' as const, description: 'VFS path to media file' },
  ],
  flags: [
    { name: 'v', type: 'bool' as const, description: 'Verbose output' },
    { name: 'f', type: 'bool' as const, description: 'Force regenerate even if derivatives exist' },
    { name: 'only', type: 'string' as const, description: `Generate one class only: ${DERIVATIVE_CLASSES.join(' | ')}` },
    { name: 'size', type: 'string' as const, description: 'Generate only these roles (comma-separated): roles of /etc/renditions.yaml, face or storyboard' },
    { name: 'prune', type: 'bool' as const, description: 'Delete renditions under thumbnails/ that are no longer targets' },
  ],
  examples: [
    'generate-derivatives /archive/albums/Exempelalbum_2019/files/IMG_0007.jpg',
    'generate-derivatives --only still /archive/albums/Exempelalbum_2019/files/IMG_0007.jpg',
  ],
  returns: 'nothing; the thumbnail, display and transcode renditions are written.',
};

export default generateDerivatives;
