#!ts
/**
 * camera-home — a camera's home bases: the berths, yards and houses where arriving ends a trip.
 *
 * `add` and `rm` change the camera's own list; `list` answers it, or the owners' residences when
 * the camera lists none. A camera is its path or its slug under the cameras root, a location its
 * path or its slug under the locations root.
 */

import { resolve } from '@std/path';
import { type CmdReturn, collectUnknownFlags, type Command, parseArgs, reportUnknownFlags } from '@ein/client';
import { CAMERAS_ROOT, LOCATIONS_ROOT } from '@archive/paths';
import { NODE_TYPE_CAMERA } from '@archive/camera/camera';
import { addCameraHome, readCameraHomes, removeCameraHome } from '@archive/camera/homes';
import type { CameraHomes } from '@archive/camera/api';

const ACTIONS = ['add', 'rm', 'list'];

const under = (root: string, cwd: string, arg: string): string => arg.includes('/') ? resolve(cwd, arg) : `${root}/${arg}`;

const cameraHome = async (cmd: Command): CmdReturn => {
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, { unknown: collectUnknownFlags(unknown) });
  if (await reportUnknownFlags(cmd, unknown)) return 1;
  const [cameraArg, action = 'list', ...locationArgs] = flags._.map(String);
  if (!cameraArg || !ACTIONS.includes(action) || (action !== 'list') !== (locationArgs.length > 0)) {
    await cmd.writeError('camera-home: usage: camera-home <camera> add|rm <location>... | camera-home <camera> [list]\n');
    return 1;
  }

  try {
    const camera = under(CAMERAS_ROOT, cmd.cwd, cameraArg);
    const node = await cmd.sys.vfs.get(cmd.access, camera).catch(() => {
      throw new Error(`${camera}: not found`);
    });
    if (node.type !== NODE_TYPE_CAMERA) throw new Error(`${camera}: not a camera (${node.type})`);

    if (action === 'list') {
      const answer = (await readCameraHomes(cmd, camera)) satisfies CameraHomes;
      if (cmd.json) {
        await cmd.writeJSON(answer);
        return 0;
      }
      if (answer.homes.length === 0) await cmd.writeLn('No home bases, and no owner with a home.');
      for (const home of answer.homes) {
        const span = home.from || home.to ? ` ${home.from ?? '…'} – ${home.to ?? ''}` : '';
        const owner = home.owner ? ` (home of ${home.owner}${span})` : '';
        await cmd.writeLn(`${home.name}  ${home.location}${owner}`);
      }
      return 0;
    }

    for (const location of locationArgs.map((arg) => under(LOCATIONS_ROOT, cmd.cwd, arg))) {
      if (action === 'add') {
        const added = await addCameraHome(cmd, camera, location);
        if (!cmd.json) await cmd.writeLn(added ? `Added ${location}` : `${location}: already a home base`);
      } else {
        const removed = await removeCameraHome(cmd, camera, location);
        if (!removed) throw new Error(`${location}: not a home base of ${camera}`);
        if (!cmd.json) await cmd.writeLn(`Removed ${location}`);
      }
    }
    if (cmd.json) await cmd.writeJSON({ ok: true });
    return 0;
  } catch (error) {
    await cmd.writeError(`camera-home: ${error instanceof Error ? error.message : String(error)}\n`);
    return 1;
  }
};

cameraHome.spec = {
  name: 'camera-home',
  effect: 'read' as const,
  description: "List or change a camera's home bases, where arriving ends a trip",
  args: [
    { name: 'camera', type: 'path' as const, description: 'the camera, by its path or its slug' },
    { name: 'action', type: 'choice' as const, choices: ACTIONS, writes: ['add', 'rm'], description: 'add, rm or list (the default)' },
    { name: 'location', type: 'path' as const, variadic: true, description: 'add, rm: locations, by their path or their slug' },
  ],
  flags: [],
  examples: [
    'camera-home exempelbaten add Exempelhamnen',
    'camera-home exempelbaten list',
    'camera-home /archive/cameras/exempelbaten rm /archive/locations/Exempelhamnen',
  ],
  returns: 'list: the home bases, each with its location, name, source (camera, or owner with the span) and point when it has one.',
};

export default cameraHome;
