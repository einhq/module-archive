#!ts
/**
 * track-trips — derive a track's trips and stays, and keep them in `<track>/.trips`.
 *
 *   track-trips <track> [--full] [--dry-run]
 *
 * `<track>` is a track's path, or what has one: a device, or a camera linked to one, by its path or
 * by its name (`trackOf`). A run reads the track from where its trips are settled, the last stay or gap that
 * ended one for good, and keeps what came before; `--full` reads all of it. How the track is cut is
 * `@archive/location/trips`; what it is cut with (the track's kind, timezone, homes and
 * `tripEdits`) is `@archive/location/track-trips`.
 *
 * The `track-trips` pipeline runs it when the track's fixes, kind, timezone or homes change.
 */

import { type CmdReturn, collectUnknownFlags, type Command, parseArgs, reportUnknownFlags } from '@ein/client';
import type { TrackTrips } from '@archive/location/api';
import { TRACK_ARG, trackOf } from '@archive/location/track';
import { deriveTrackTrips } from '@archive/location/track-trips';

const trackTrips = async (cmd: Command): CmdReturn => {
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, { boolean: ['full', 'dry-run'], unknown: collectUnknownFlags(unknown) });
  if (await reportUnknownFlags(cmd, unknown)) return 1;
  const target = flags._[0] === undefined ? undefined : String(flags._[0]);
  if (!target) {
    await cmd.writeError('track-trips: usage: track-trips <track> [--full] [--dry-run]\n');
    return 1;
  }

  try {
    const { path } = await trackOf(cmd, target);
    const derived = await deriveTrackTrips(cmd, path, { full: flags.full, dryRun: flags['dry-run'] });
    if (cmd.json) {
      await cmd.writeJSON(derived satisfies TrackTrips);
    } else {
      const ongoing = derived.trips.filter((trip) => trip.ongoing).length;
      await cmd.writeLn(
        `${path}: ${derived.trips.length} trip${derived.trips.length === 1 ? '' : 's'}${ongoing ? ` (${ongoing} ongoing)` : ''}, ` +
          `${derived.stays.length} stay${derived.stays.length === 1 ? '' : 's'}` +
          (derived.settledUntil ? `, settled until ${derived.settledUntil}` : '') +
          (flags['dry-run'] ? ' (dry run, nothing written)' : ''),
      );
    }
    return 0;
  } catch (error) {
    await cmd.writeError(`track-trips: ${error instanceof Error ? error.message : String(error)}\n`);
    return 1;
  }
};

trackTrips.spec = {
  name: 'track-trips',
  effect: 'write' as const,
  description: "Derive a track's trips and stays, into <track>/.trips",
  args: [
    { name: 'track', type: 'path' as const, description: TRACK_ARG },
  ],
  flags: [
    { name: 'full', type: 'bool' as const, description: 'read the whole track, not only from where its trips are settled' },
    { name: 'dry-run', dryRun: true, type: 'bool' as const, description: 'derive and show them without writing .trips' },
  ],
  examples: ['track-trips sailboat', 'track-trips /dev/sailboat/position --full --dry-run'],
};

export default trackTrips;
