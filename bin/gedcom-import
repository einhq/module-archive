#!ts
/**
 * gedcom-import — bring a GEDCOM file's people, their relations, events, homes and notes into
 * the archive.
 *
 *   gedcom-import <file.ged> [--dry-run]
 *
 * The file is kept in `/archive/sources/genealogy/`: moved there from staging, copied from
 * anywhere else, and not kept twice when the same bytes are there already. Each individual is
 * matched to a person of the archive or made one (`importGedcom`), and every person the file
 * describes links it from their `sources/`. What the file says of them is added where they lack
 * it: their events and facts as events, a place that names a location placing the event there, a
 * residence at a location as a home, and their notes as their description. Importing the same
 * file again finds the same people and adds nothing. `--dry-run` says what would happen and
 * writes nothing.
 *
 * A staged file is imported as the person whose staging area it is in, whoever runs this: the
 * pipeline runs it with administrative access, and the import may change only the people its
 * owner may.
 */
import type { CmdReturn, Command } from '@ein/client';
import { accessOfUser, collectUnknownFlags, isAdmin, parseArgs, reportUnknownFlags } from '@ein/client';
import { dirname, resolve } from '@std/path';
import { toArrayBuffer } from '@std/streams/to-array-buffer';
import { GENEALOGY_SOURCES } from '@archive/paths';
import { readGedcom } from '@archive/people/gedcom';
import { importGedcom } from '@archive/people/gedcom-import';
import type { GedcomImportResult } from '@archive/people/api';
import { fileSource, sha256Hex } from '@archive/sources';
import { parseStagedPath } from '@archive/staging/paths';

/** The type a kept GEDCOM file is given, which keeps it out of text extraction. */
const GEDCOM_MIMETYPE = 'application/x-gedcom';

const gedcomImport = async (cmd: Command): CmdReturn => {
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, { boolean: ['dry-run'], unknown: collectUnknownFlags(unknown) });
  if (await reportUnknownFlags(cmd, unknown)) return 1;

  const target = flags._[0] as string | undefined;
  if (!target) {
    await cmd.writeError('gedcom-import: usage: gedcom-import <file.ged> [--dry-run]\n');
    return 1;
  }
  const vfs = cmd.sys.vfs;
  const access = cmd.access;
  const path = resolve(cmd.cwd, target);
  const dryRun = Boolean(flags['dry-run']);

  try {
    const handle = await vfs.open(access, path, { mode: 'r' });
    let bytes: Uint8Array;
    try {
      bytes = new Uint8Array(await toArrayBuffer(handle.readable));
    } finally {
      await handle.close();
    }

    const gedcom = readGedcom(bytes);
    if (gedcom.individuals.length === 0) {
      await cmd.writeError(`gedcom-import: ${path}: no individuals found; is it a GEDCOM file?\n`);
      return 1;
    }

    const place = parseStagedPath(path);
    const as = place && isAdmin(access) ? await accessOfUser(vfs, access, place.user) : access;
    const sha256 = await sha256Hex(bytes);
    let source = path;
    if (dirname(path) !== GENEALOGY_SOURCES) {
      if (dryRun) {
        const held = await vfs.children(as, GENEALOGY_SOURCES, { follow: false }).catch(() => []);
        const same = held.find((entry) => (entry.node.attrs as { sha256?: unknown }).sha256 === sha256);
        if (same) source = `${GENEALOGY_SOURCES}/${same.name}`;
      } else {
        source = (await fileSource(vfs, as, path, GENEALOGY_SOURCES, { sha256, copy: !place, attrs: { mimetype: GEDCOM_MIMETYPE } })).path;
      }
    }

    const result = await importGedcom(vfs, as, gedcom, source, { dryRun });

    if (cmd.json) {
      await cmd.writeJSON(result satisfies GedcomImportResult);
      return 0;
    }
    const would = dryRun ? 'would be ' : '';
    await cmd.writeLn(`${result.individuals} individuals and ${result.families} families in ${dryRun ? path : result.source}`);
    for (const match of result.matched) await cmd.writeLn(`  ${match.xref} ${match.name} = ${match.person} (${match.how})`);
    for (const made of result.created) await cmd.writeLn(`  ${made.xref} ${made.name} → ${made.person} ${would}made`);
    for (const skip of result.skipped) await cmd.writeLn(`  ${skip.xref} skipped: ${skip.reason}`);
    await cmd.writeLn(
      `${result.matched.length} found in the archive, ${result.created.length} ${would}made, ${result.parents} parent and ${result.partners} partner relations, ${result.events} events and ${result.homes} homes ${would}added`,
    );
  } catch (error) {
    await cmd.writeError(`gedcom-import: ${error instanceof Error ? error.message : String(error)}\n`);
    return 1;
  }
  return 0;
};

gedcomImport.spec = {
  name: 'gedcom-import',
  effect: 'write' as const,
  description:
    "Import a GEDCOM file's people and relations: match each individual to a person of the archive or make one, add missing parents, partners, events, homes and descriptions, and keep the file in /archive/sources/genealogy, linked from every person it describes",
  args: [
    { name: 'file', type: 'path' as const, description: 'the GEDCOM (.ged) file' },
  ],
  flags: [
    { name: 'dry-run', dryRun: true, type: 'bool' as const, description: 'say who would be matched, made and related, and what would be added, and write nothing' },
  ],
  examples: ['gedcom-import /home/ruby/wrenfield.ged --dry-run', 'gedcom-import /home/ruby/wrenfield.ged'],
  returns: 'the kept file, who each individual was found to be or was made, what was skipped, and how many relations, events and homes were added.',
};

export default gedcomImport;
