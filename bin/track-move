#!ts
/**
 * track-move — move the fixes of a time range from one track to another.
 *
 *   track-move <track> <to-track> [--from <iso>] [--to <iso>]
 *
 * For a trip recorded into the wrong track. Each track is its path, or what has one: a device or a
 * camera, by its path or by its name (`trackOf`). The range is half-open, `[from, to)`; either end
 * left out runs to that end of the track. The fixes keep what a person said of them
 * (`track-mark`), and both tracks judge again what the move changes. A fix whose time the other
 * track holds already leaves all the same, and the other keeps its own. The GPX files the fixes
 * were read from stay where they are.
 *
 * Output: how many fixes moved; `{"moved": n, "to": "<track>"}` in JSON mode.
 */
import { openTrack, TRACK_ARG, trackOf } from '@archive/location/track';
import type { CmdReturn, Command } from '@ein/client';
import { collectUnknownFlags, parseArgs, reportUnknownFlags } from '@ein/client';
import type { TrackMove } from '@archive/location/api';

const USAGE = 'track-move: usage: track-move <track> <to-track> [--from <iso>] [--to <iso>]\n';

const trackMove = async (cmd: Command): CmdReturn => {
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, { string: ['from', 'to'], unknown: collectUnknownFlags(unknown) });
  if (await reportUnknownFlags(cmd, unknown)) return 1;

  const [source, target] = flags._.map(String);
  if (!source || !target || flags._.length !== 2) {
    await cmd.writeError(USAGE);
    return 1;
  }

  try {
    for (const [name, value] of [['from', flags.from], ['to', flags.to]] as const) {
      if (value !== undefined && Number.isNaN(Date.parse(value))) throw new Error(`invalid --${name} '${value}'`);
    }

    const to = (await trackOf(cmd, target)).path;
    const from = await openTrack(cmd, source, 'a');
    let moved: number;
    try {
      if (to === from.path) throw new Error(`${from.path} is the track the fixes are on`);
      const into = await openTrack(cmd, to, 'a');
      try {
        moved = await from.handle.movePoints({ from: flags.from, to: flags.to }, into.handle);
      } finally {
        await into.handle.close();
      }
    } finally {
      await from.handle.close();
    }

    if (cmd.json) {
      await cmd.writeLn(JSON.stringify({ moved, to } satisfies TrackMove));
    } else {
      await cmd.writeLn(`Moved ${moved} fix${moved === 1 ? '' : 'es'} to ${to}`);
    }
  } catch (error) {
    await cmd.writeError(`track-move: ${error instanceof Error ? error.message : String(error)}\n`);
    return 1;
  }

  return 0;
};

trackMove.spec = {
  name: 'track-move',
  effect: 'write' as const,
  description: 'Move the fixes of a time range from one track to another, for a trip recorded into the wrong track',
  args: [
    { name: 'track', type: 'path' as const, description: `the track the fixes are on: ${TRACK_ARG}` },
    { name: 'to-track', type: 'path' as const, description: `the track to move them to: ${TRACK_ARG}` },
  ],
  flags: [
    { name: 'from', type: 'string' as const, description: 'only fixes at or after this ISO timestamp' },
    { name: 'to', type: 'string' as const, description: 'only fixes before this ISO timestamp' },
  ],
  examples: ['track-move anna-phone sailboat --from=2025-07-01T06:00:00Z --to=2025-07-03T18:00:00Z'],
};

export default trackMove;
