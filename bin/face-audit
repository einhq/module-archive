#!ts
/**
 * face-audit — find transferred faces that look like somebody else.
 *
 * `tag-transfer` gave each legacy tag's name to a detection inside its box. A transfer that
 * landed on the wrong face is an anchor like any other: recognition votes from it, and nothing
 * else questions it. This compares every human-named face (`transfer`, `manual`) with every
 * other, leaving out faces from the same photo, and marks a `transfer` face whose nearest one
 * belongs to another person with `doubt` (@archive/media/regions). A person's Faces tab lists
 * those for a human, who takes the wrong ones off with "Not <name>" and confirms the rest
 * (`face-confirm`).
 *
 * Each run replaces the previous findings: a face that no longer qualifies loses its doubt. The
 * comparison is exact and quadratic (@archive/media/face-audit), a minute or two for twenty
 * thousand anchors, in a worker, so the process keeps serving meanwhile.
 */
import type { CmdReturn, Command } from '@ein/client';
import { collectUnknownFlags, parseArgs, reportUnknownFlags } from '@ein/client';
import { type Anchor, disagrees, nearestAnchors } from '@archive/media/face-audit';
import { allRegions, FACE_EMBEDDING_TYPE, type FaceDoubt, type RegionAttrs } from '@archive/media/regions';
import type { FaceAuditResult } from '@archive/media/api';

/** The sources a human stands behind; recognition's own guesses are not evidence. */
const ANCHOR_SOURCES = new Set(['transfer', 'manual']);

/** Vectors per `getVectors` round trip. */
const VECTOR_BATCH = 2000;

const PERSON_QUERY_LIMIT = 500000;

const nowIso = () => new Date().toISOString().replace(/\.\d+Z$/, 'Z');

const faceAudit = async (cmd: Command): CmdReturn => {
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, {
    boolean: ['dry-run', 'verbose'],
    alias: { n: 'dry-run', v: 'verbose' },
    unknown: collectUnknownFlags(unknown),
  });
  if (await reportUnknownFlags(cmd, unknown)) return 1;
  const dryRun = !!flags['dry-run'];
  const verbose = !!flags.verbose;
  const vfs = cmd.sys.vfs;
  const access = cmd.access;

  try {
    const { faces, tags } = await allRegions(vfs, access);
    const named = faces.filter((face) => typeof face.attrs.personId === 'string' && ANCHOR_SOURCES.has(face.attrs.personSource ?? ''));

    const vectors = new Map<string, number[]>();
    const decoder = new TextDecoder();
    for (let i = 0; i < named.length; i += VECTOR_BATCH) {
      const batch = await vfs.getVectors(access, FACE_EMBEDDING_TYPE, named.slice(i, i + VECTOR_BATCH).map((face) => face.embeddingId));
      for (const [id, data] of batch) vectors.set(id, JSON.parse(decoder.decode(data)));
    }
    const anchored = named.filter((face) => vectors.has(face.embeddingId));
    const anchors: Anchor[] = anchored.map((face) => ({
      person: face.attrs.personId!,
      file: face.attrs.fileId,
      vector: vectors.get(face.embeddingId)!,
    }));
    vectors.clear();

    const nearest = await nearestAnchors(anchors);

    const auditedAt = nowIso();
    const doubts = new Map<string, FaceDoubt>();
    let audited = 0;
    for (let i = 0; i < anchored.length; i++) {
      if (anchored[i].attrs.personSource !== 'transfer') continue;
      audited++;
      const { own, other } = nearest[i];
      if (!disagrees(nearest[i])) continue;
      doubts.set(anchored[i].regionPath, {
        personId: anchors[i].person,
        likePersonId: anchors[other!.index].person,
        similarity: round(other!.similarity),
        ownSimilarity: round(own!.similarity),
        auditedAt,
      });
    }

    // Every earlier finding not repeated now goes, on faces and on regions that lost their vector.
    const stale = [...faces, ...tags]
      .filter((region) => (region.attrs as RegionAttrs).doubt && !doubts.has(region.regionPath))
      .map((region) => region.regionPath);
    if (!dryRun) {
      for (const [path, doubt] of doubts) await vfs.update(access, path, { attrs: { doubt } });
      // null removes the key.
      for (const path of stale) await vfs.update(access, path, { attrs: { doubt: null } });
    }

    const people = await vfs.query(access, { types: ['person'], limit: PERSON_QUERY_LIMIT });
    const personOf = new Map(people.map((row) => [row.id, { path: row.absPath, name: String((row.node.attrs as { name?: unknown }).name ?? row.absPath.split('/').pop()) }]));
    const nameOf = (id: string) => personOf.get(id)?.name ?? id;

    const rows = [...doubts]
      .map(([facePath, doubt]) => ({ facePath, personId: doubt.personId, likePersonId: doubt.likePersonId, similarity: doubt.similarity, ownSimilarity: doubt.ownSimilarity }))
      .sort((a, b) => (b.similarity - b.ownSimilarity) - (a.similarity - a.ownSimilarity) || a.facePath.localeCompare(b.facePath));
    const perPerson = new Map<string, number>();
    for (const row of rows) perPerson.set(row.personId, (perPerson.get(row.personId) ?? 0) + 1);

    const result = {
      anchors: anchors.length,
      audited,
      doubtful: rows.length,
      cleared: stale.length,
      dryRun,
      people: [...perPerson]
        .map(([id, doubtful]) => ({ id, ...(personOf.has(id) ? { path: personOf.get(id)!.path } : {}), name: nameOf(id), doubtful }))
        .sort((a, b) => b.doubtful - a.doubtful || a.name.localeCompare(b.name)),
      faces: rows,
    } satisfies FaceAuditResult;

    if (cmd.json) {
      await cmd.writeJSON(result);
      return 0;
    }
    await cmd.writeLn(
      `${result.audited} transferred faces audited against ${result.anchors} named faces: ${result.doubtful} look like somebody else` +
        `, ${result.cleared} earlier doubt${result.cleared === 1 ? '' : 's'} cleared${dryRun ? ' (dry run)' : ''}`,
    );
    for (const person of result.people) await cmd.writeLn(`  ${String(person.doubtful).padStart(4)}  ${person.path ?? person.name}`);
    if (verbose) {
      for (const row of rows) {
        await cmd.writeLn(`${row.facePath}  ${nameOf(row.personId)} ${row.ownSimilarity.toFixed(3)} < ${nameOf(row.likePersonId)} ${row.similarity.toFixed(3)}`);
      }
    }
    return 0;
  } catch (error) {
    await cmd.writeError(`face-audit: ${error instanceof Error ? error.message : String(error)}\n`);
    return 1;
  }
};

const round = (value: number) => Math.round(value * 1000) / 1000;

faceAudit.spec = {
  name: 'face-audit',
  effect: 'write' as const,
  description: 'Mark transferred faces whose nearest human-named face in another photo is somebody else',
  args: [],
  flags: [
    { name: 'dry-run', dryRun: true, type: 'bool' as const, description: 'report without marking or clearing anything' },
    { name: 'verbose', type: 'bool' as const, description: 'list every doubtful face' },
  ],
  examples: [
    'face-audit --dry-run',
    'face-audit --verbose',
  ],
  returns: 'how many transferred faces look like somebody else, per person; marks them for review in the Faces tab.',
};

export default faceAudit;
