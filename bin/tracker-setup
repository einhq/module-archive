#!ts
/**
 * tracker-setup — live tracking from a phone or GPS tracker: the link a device's fixes are posted
 * to, and the QR code that sets Traccar Client up with it.
 *
 *   tracker-setup <device> [--origin <url>]          whether it is on, and the link
 *   tracker-setup <device> --new [--origin <url>]    turn it on, or replace the link
 *   tracker-setup <device> --off                     turn it off
 *
 * `--new` gives the device a track when it has none. The link is core's `track-token`; `--origin`
 * is the address the phone reaches EiN at, which only the asker knows, and with it the answer
 * carries the full URL and the QR code. The QR code is the URL with `?id=<device slug>`, which
 * Traccar Client reads as the server URL and the device identifier.
 */
import { basename } from '@std/path';
import type { TrackToken } from '@ein/api';
import type { CmdReturn, Command } from '@ein/client';
import { collectUnknownFlags, parseArgs, reportUnknownFlags, shq } from '@ein/client';
import type { TrackerSetup } from '@archive/device/api';
import { qrSvg } from '@archive/device/qr';
import { ensureTrack, trackOf } from '@archive/location/track';

const USAGE = 'usage: tracker-setup <device> [--new|--off] [--origin <url>]';

const trackerSetup = async (cmd: Command): CmdReturn => {
  const unknown: string[] = [];
  const flags = parseArgs(cmd.args, { boolean: ['new', 'off'], string: ['origin'], unknown: collectUnknownFlags(unknown) });
  if (await reportUnknownFlags(cmd, unknown)) return 1;

  const fail = async (message: string): Promise<number> => {
    await cmd.writeError(`tracker-setup: ${message}\n`);
    return 1;
  };

  const target = flags._[0] as string | undefined;
  if (!target) return await fail(USAGE);
  if (flags.new && flags.off) return await fail('--new and --off do not go together');

  let origin: string | undefined;
  if (flags.origin) {
    try {
      origin = new URL(flags.origin).origin;
    } catch {
      return await fail(`--origin takes a URL such as https://ein.example, not '${flags.origin}'`);
    }
  }

  try {
    const { path: track, device } = await trackOf(cmd, target);
    if (flags.new) await ensureTrack(cmd, device);

    let token: TrackToken = { track, enabled: false };
    if (await cmd.sys.vfs.exists(cmd.access, track)) {
      const ran = await cmd.execute(`JSON_OUTPUT=1 track-token ${shq(track)}${flags.new ? ' --new' : flags.off ? ' --off' : ''}`);
      if (ran.code !== 0) return await fail(ran.stderr.trim().replace(/^track-token: /, '') || 'track-token failed');
      token = JSON.parse(ran.stdout) as TrackToken;
    }

    const answer: TrackerSetup = { device, track, enabled: token.enabled };
    if (token.path) {
      answer.url = origin ? `${origin}${token.path}` : token.path;
      if (origin) {
        answer.qrText = `${answer.url}?id=${encodeURIComponent(basename(device))}`;
        answer.qrSvg = qrSvg(answer.qrText);
      }
    }

    if (cmd.json) await cmd.writeJSON(answer satisfies TrackerSetup);
    else await cmd.writeLn(answer.url ?? `${device} takes no tracker posts`);
    return 0;
  } catch (error) {
    return await fail(error instanceof Error ? error.message : String(error));
  }
};

trackerSetup.spec = {
  name: 'tracker-setup',
  effect: 'read' as const,
  description: "Show, turn on, replace or turn off the link a phone or GPS tracker posts a device's position to",
  args: [
    { name: 'device', type: 'string' as const, description: 'the device: its slug under the devices root, or its path' },
  ],
  flags: [
    { name: 'new', writes: true, type: 'bool' as const, description: 'turn live tracking on, or replace the link; the one before it stops working' },
    { name: 'off', writes: true, type: 'bool' as const, description: 'turn live tracking off' },
    { name: 'origin', type: 'string' as const, description: 'the address the phone reaches EiN at, such as https://ein.example; adds the full URL and the QR code' },
  ],
  examples: ['tracker-setup sailboat', 'tracker-setup sailboat --new --origin https://ein.example'],
  returns: 'TrackerSetup: whether live tracking is on, the link, and the QR code.',
};

export default trackerSetup;
