{
  "sidebar": [
    {
      "id": "archive.media",
      "section": "main",
      "label": "Media",
      "icon": "photo-search",
      "to": "/media",
      "order": 30,
      "shortcut": "alt+I"
    },
    {
      "id": "archive.staging",
      "section": "main",
      "label": "Staging",
      "icon": "inbox",
      "to": "/staging",
      "order": 40,
      "signedIn": true
    },
    {
      "id": "archive.year",
      "section": "explore",
      "label": "Year",
      "icon": "calendar-search",
      "to": "/year",
      "order": 20,
      "shortcut": "alt+Y"
    },
    {
      "id": "archive.map",
      "section": "explore",
      "label": "Map",
      "icon": "map",
      "to": "/map",
      "order": 30,
      "shortcut": "alt+G"
    },
    {
      "id": "archive.people",
      "section": "browse",
      "label": "People",
      "icon": "users",
      "to": "/people",
      "order": 20,
      "shortcut": "alt+P"
    },
    {
      "id": "archive.locations",
      "section": "browse",
      "label": "Locations",
      "icon": "map-pin",
      "to": "/locations",
      "order": 30,
      "shortcut": "alt+L"
    },
    {
      "id": "archive.cameras",
      "section": "browse",
      "label": "Cameras",
      "icon": "device-camera-phone",
      "to": "/cameras",
      "order": 50
    },
    {
      "id": "archive.albums",
      "section": "browse",
      "label": "Albums",
      "icon": "photo",
      "to": "/albums",
      "order": 10,
      "shortcut": "alt+A"
    }
  ],
  "topbar": [
    {
      "id": "archive.import",
      "parent": "ui.create",
      "title": "Upload",
      "icon": "upload",
      "color": "indigo",
      "action": {
        "navigate": "/staging"
      },
      "order": 5,
      "signedIn": true
    },
    {
      "id": "archive.create-person",
      "parent": "ui.create",
      "title": "Person",
      "icon": "user",
      "color": "grape",
      "action": {
        "dialog": "/people/new"
      },
      "order": 20
    },
    {
      "id": "archive.create-location",
      "parent": "ui.create",
      "title": "Location",
      "icon": "map-pin",
      "color": "teal",
      "action": {
        "dialog": "/locations/new"
      },
      "order": 30
    },
    {
      "id": "archive.create-camera",
      "parent": "ui.create",
      "title": "Camera",
      "icon": "device-camera-phone",
      "color": "orange",
      "action": {
        "dialog": "/cameras/new"
      },
      "order": 40
    },
    {
      "id": "archive.create-album",
      "parent": "ui.create",
      "title": "Album",
      "icon": "photo",
      "color": "blue",
      "action": {
        "dialog": "/albums/new"
      },
      "order": 10
    },
    {
      "id": "archive.favourites",
      "parent": "ui.account",
      "title": "Favourites",
      "icon": "heart",
      "action": {
        "navigate": "/favourites"
      },
      "order": 10
    },
    {
      "id": "archive.random-album",
      "title": "Random album",
      "icon": "arrows-shuffle",
      "place": "search",
      "shortcut": "alt+R",
      "action": {
        "run": "album-random",
        "navigate": "/albums/{path}"
      },
      "order": 30
    }
  ],
  "panels": [
    {
      "id": "archive.trips",
      "slot": "device.tabs",
      "label": "Trips",
      "icon": "map-route",
      "route": "/trips?device={path}",
      "when": {
        "has": "track"
      }
    },
    {
      "id": "archive.app-backup",
      "slot": "app.backup",
      "label": "Back up into",
      "icon": "inbox",
      "route": "/staging/app-backup",
      "signedIn": true
    },
    {
      "id": "archive.share",
      "slot": "share.receive",
      "label": "Upload",
      "icon": "upload",
      "route": "/staging/receive",
      "signedIn": true
    },
    {
      "id": "archive.duplicates",
      "slot": "nodes.tools",
      "label": "Duplicates",
      "icon": "copy",
      "route": "/duplicates?path={path}"
    },
    {
      "id": "archive.life-events",
      "slot": "stats.sections",
      "label": "Events",
      "route": "/stats/life-events"
    },
    {
      "id": "archive.start-upload",
      "signedIn": true,
      "slot": "home.start",
      "label": "Upload",
      "route": "/start/upload"
    },
    {
      "id": "archive.explore-people",
      "slot": "search.explore",
      "label": "People",
      "route": "/explore/people",
      "order": 10
    },
    {
      "id": "archive.explore-locations",
      "slot": "search.explore",
      "label": "Locations",
      "route": "/explore/locations",
      "order": 20
    },
    {
      "id": "archive.explore-years",
      "slot": "search.explore",
      "label": "Years",
      "route": "/explore/years",
      "order": 30
    },
    {
      "id": "archive.explore-labels",
      "slot": "search.explore",
      "label": "Labels",
      "route": "/explore/labels",
      "order": 40
    },
    {
      "id": "archive.looks-like",
      "signedIn": true,
      "slot": "search.label",
      "label": "Looks like",
      "route": "/looks-like?path={path}"
    }
  ],
  "layers": [
    {
      "id": "archive.media",
      "label": "Photos and videos",
      "icon": "photo",
      "description": "Where they were taken; a pile opens the pictures in it.",
      "route": "/map-layers/archive/media",
      "order": 10,
      "on": true,
      "params": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "title": "Search",
            "description": "Only what matches this text."
          },
          "from": {
            "type": "integer",
            "title": "From year",
            "minimum": 1000,
            "maximum": 9999
          },
          "to": {
            "type": "integer",
            "title": "To year",
            "minimum": 1000,
            "maximum": 9999
          }
        }
      }
    },
    {
      "id": "archive.locations",
      "label": "Locations",
      "icon": "map-pin",
      "description": "The archive's places, each opening its page.",
      "route": "/map-layers/archive/locations",
      "order": 20,
      "on": true
    },
    {
      "id": "archive.tracks",
      "label": "Tracks",
      "icon": "route",
      "description": "Where you went, and where the tracks recording now are.",
      "route": "/map-layers/archive/tracks",
      "order": 30,
      "on": true
    }
  ]
}
