  "config": {
    "options": [
      {
        "key": "CFG_FACE_ATTACH_THRESHOLD",
        "scope": "system",
        "type": "number",
        "default": "0.56",
        "label": "Face match threshold",
        "description": "How similar two faces must be before one is attached to a known person. Higher is stricter and produces fewer wrong matches but more unknown faces.",
        "group": "Faces"
      },
      {
        "key": "CFG_FACE_MIN_CONFIDENCE",
        "scope": "system",
        "type": "number",
        "default": "0.7",
        "label": "Minimum face confidence",
        "description": "How sure the detector must be before a box is kept as a face that takes part in recognition. Below 0.7 most detections are backs of heads, blur or things that are not faces, and they pull strangers toward the wrong person. Applies to new detections; a box below it is not stored unless someone tags it by hand.",
        "group": "Faces"
      },
      {
        "key": "CFG_FACE_MIN_SIZE",
        "scope": "system",
        "type": "number",
        "default": "24",
        "label": "Minimum face size (px)",
        "description": "The shorter side a face box must have, in pixels of the displayed photo, to be kept as a face.",
        "group": "Faces"
      },
      {
        "key": "CFG_FACE_MAX_YAW",
        "scope": "system",
        "type": "number",
        "default": "80",
        "label": "Maximum head turn (degrees)",
        "description": "How far a head may be turned away from the camera, estimated from the eyes, nose and mouth, and still be kept as a face. Full profiles beyond this match the wrong person far more often.",
        "group": "Faces"
      },
      {
        "key": "CFG_USER_SLIDESHOW_SECONDS",
        "scope": "user",
        "type": "number",
        "default": "3",
        "label": "Seconds per slide",
        "description": "How long each photo is shown in a slideshow.",
        "group": "Playback"
      },
      {
        "key": "CFG_USER_KEN_BURNS",
        "scope": "user",
        "type": "boolean",
        "default": "true",
        "label": "Ken Burns effect",
        "description": "Slowly pan and zoom each photo during a slideshow.",
        "group": "Playback"
      },
      {
        "key": "CFG_MEDIA_HEAL_INTERVAL",
        "scope": "system",
        "type": "number",
        "default": "900",
        "label": "Gap check interval (seconds)",
        "description": "How often the background check looks for media missing something a pipeline should have given it, when nothing else is waiting to be processed.",
        "group": "Processing",
        "restarts": ["media-heal"]
      },
      {
        "key": "CFG_MEDIA_HEAL_REST",
        "scope": "system",
        "type": "number",
        "default": "21600",
        "label": "Rest after a full gap check (seconds)",
        "description": "How long the background gap check waits after a pass through the whole archive that found nothing before it starts another.",
        "group": "Processing",
        "restarts": ["media-heal"]
      },
      {
        "key": "CFG_FACE_VOTE_THRESHOLD",
        "scope": "system",
        "type": "number",
        "default": "0.51",
        "label": "Face neighbour similarity",
        "description": "How similar a known face must be to count as a vote for its person. Faces less alike than this are ignored when deciding who an unknown face is.",
        "group": "Faces"
      },
      {
        "key": "CFG_FACE_K",
        "scope": "system",
        "type": "number",
        "default": "24",
        "label": "Face neighbours compared",
        "description": "How many of the most similar known faces are compared with each unknown one.",
        "group": "Faces"
      },
      {
        "key": "CFG_FACE_MARGIN",
        "scope": "system",
        "type": "number",
        "default": "1.2",
        "label": "Face winner margin",
        "description": "How far the leading person's votes must outweigh the runner-up's before a face is attached. 1.2 means 20% more; higher leaves close calls unknown.",
        "group": "Faces"
      },
      {
        "key": "CFG_FACE_MIN_CREATE_CONFIDENCE",
        "scope": "system",
        "type": "number",
        "default": "0.7",
        "label": "Confidence to start a new person from a face",
        "description": "How sure the detector must be of a face that matches nobody before it starts a new, unnamed person. Less certain faces stay unknown.",
        "group": "Faces"
      },
      {
        "key": "CFG_FACE_MIN_CREATE_SIZE",
        "scope": "system",
        "type": "number",
        "default": "48",
        "label": "Size to start a new person from a face (px)",
        "description": "The shorter side, in pixels, a face that matches nobody must have before it starts a new, unnamed person. Small faces stay unknown rather than seeding people from blur.",
        "group": "Faces"
      },
      {
        "key": "CFG_VOICE_ATTACH_THRESHOLD",
        "scope": "system",
        "type": "number",
        "default": "0.55",
        "label": "Voice match threshold",
        "description": "How similar a voice in a recording must be to a known voice before it is attached to that person. Higher is stricter and produces fewer wrong matches but more unknown speakers.",
        "group": "Voices"
      },
      {
        "key": "CFG_VOICE_PERSON_THRESHOLD",
        "scope": "system",
        "type": "number",
        "default": "0.7",
        "label": "Voice likeness to the person",
        "description": "How similar a voice must be to the average of a person's voices before it joins them. Stops a person drifting from one speaker to the next through a chain of loosely similar voices.",
        "group": "Voices"
      },
      {
        "key": "CFG_VOICE_ASD_PERSON_THRESHOLD",
        "scope": "system",
        "type": "number",
        "default": "0.5",
        "label": "Voice likeness to the person seen speaking",
        "description": "How similar a voice must be to the average of a person's voices before a face seen speaking with it may join them. Lower than the plain likeness bar, since the face is evidence too; it stops the camera operator's voice going to whoever is in frame.",
        "group": "Voices"
      },
      {
        "key": "CFG_VOICE_VOTE_THRESHOLD",
        "scope": "system",
        "type": "number",
        "default": "0.5",
        "label": "Voice neighbour similarity",
        "description": "How similar a known voice must be to count as a vote for its person. Voices less alike than this are ignored when deciding who is speaking.",
        "group": "Voices"
      },
      {
        "key": "CFG_VOICE_K",
        "scope": "system",
        "type": "number",
        "default": "24",
        "label": "Voice neighbours compared",
        "description": "How many of the most similar known voices are compared with each unknown one.",
        "group": "Voices"
      },
      {
        "key": "CFG_VOICE_MARGIN",
        "scope": "system",
        "type": "number",
        "default": "1.2",
        "label": "Voice winner margin",
        "description": "How far the leading person's votes must outweigh the runner-up's before a voice is attached. 1.2 means 20% more; higher leaves close calls unknown.",
        "group": "Voices"
      },
      {
        "key": "CFG_VOICE_MIN_CREATE_SECONDS",
        "scope": "system",
        "type": "number",
        "default": "10",
        "label": "Speech to start a new person (seconds)",
        "description": "How long a voice that matches nobody must have spoken in a recording, in all, before it starts a new, unnamed person. Voices heard for less stay unknown.",
        "group": "Voices"
      },
      {
        "key": "CFG_VOICE_ASD_VOTE_WEIGHT",
        "scope": "system",
        "type": "number",
        "default": "0.9",
        "label": "Lip-sync vote weight",
        "description": "How much it counts, as a similarity, that a person's face is seen speaking in step with the voice. Only voices someone named or locked are weighed against it.",
        "group": "Voices"
      },
      {
        "key": "CFG_VOICE_ASD_MIN_SCORE",
        "scope": "system",
        "type": "number",
        "default": "0.6",
        "label": "Minimum lip-sync score",
        "description": "How clearly a face must be seen speaking in step with a voice before that counts as a vote at all.",
        "group": "Voices"
      },
      {
        "key": "CFG_ALBUM_STACK_THRESHOLD",
        "scope": "system",
        "type": "number",
        "default": "0.75",
        "label": "Stack similarity",
        "description": "How alike two neighbouring photos in an album must look to be stacked as one burst. Higher stacks only near-identical shots.",
        "group": "Albums",
        "restarts": [
          "album-metadata"
        ]
      },
      {
        "key": "CFG_ALBUM_STACK_MAX_GAP_SECONDS",
        "scope": "system",
        "type": "number",
        "default": "10",
        "label": "Stack time gap (seconds)",
        "description": "How far apart in capture time two neighbouring photos may be and still be stacked together.",
        "group": "Albums",
        "restarts": [
          "album-metadata"
        ]
      },
      {
        "key": "CFG_WEATHER",
        "scope": "system",
        "type": "boolean",
        "default": "false",
        "label": "Look up the weather",
        "description": "Let EiN ask SMHI and Open-Meteo what the weather was at a place and time. Each lookup sends the coordinates and the date to them, so it is off until you turn it on.",
        "group": "Places"
      },
      {
        "key": "CFG_WEATHER_SMHI_KM",
        "scope": "system",
        "type": "number",
        "default": "30",
        "label": "SMHI station distance (km)",
        "description": "How far from a place the nearest SMHI weather station may be and still give its weather. Farther away, and outside Sweden, the weather comes from Open-Meteo's reanalysis instead. 0 leaves SMHI out.",
        "group": "Places"
      }
    ]
  },
  "environment": [
    {
      "key": "NOMINATIM_SEARCH_URL",
      "kind": "option",
      "default": "https://nominatim.openstreetmap.org/search",
      "description": "Where geocoding asks Nominatim for an address, as geocode-location and location-region do. Point it at your own server to avoid the public one's rate limit."
    },
    {
      "key": "NOMINATIM_REVERSE_URL",
      "kind": "option",
      "default": "https://nominatim.openstreetmap.org/reverse",
      "description": "Where Nominatim is asked for the address at a point: a picture's street address (geocode-position), and the town around a stay that has no harbour, island or bay nearby (track-places)."
    },
    {
      "key": "OVERPASS_URL",
      "kind": "option",
      "default": "https://overpass-api.de/api/interpreter https://overpass.private.coffee/api/interpreter",
      "description": "Where track-places asks OpenStreetMap's Overpass API for the harbours, islands and bays a device stayed at: one or more endpoints, separated by spaces, tried in turn. Point it at your own server to avoid the public ones' rate limit."
    },
    {
      "key": "SMHI_METOBS_URL",
      "kind": "option",
      "default": "https://opendata-download-metobs.smhi.se/api/version/1.0",
      "description": "Where weather asks SMHI's meteorological observations for the weather stations and their hourly values."
    },
    {
      "key": "OPEN_METEO_ARCHIVE_URL",
      "kind": "option",
      "default": "https://archive-api.open-meteo.com/v1/archive",
      "description": "Where weather asks Open-Meteo's historical weather API for the hourly weather of places with no SMHI station near them."
    }
  ],
  "nodeTypes": [
    {
      "type": "album",
      "label": "Album",
      "category": "content",
      "root": "/archive/albums",
      "searchable": true,
      "plural": "Albums",
      "description": "A collection of photos and videos that behaves as a directory. It holds its files, and links the ones added to it from elsewhere. It remembers its cover, the time span of its media, and the stacks of similar photos taken in a row."
    },
    {
      "type": "person",
      "label": "Person",
      "category": "content",
      "root": "/archive/people",
      "searchable": true,
      "plural": "People",
      "description": "Someone in the archive, with names, dates of birth and death, and contact details. Parents, children and partners are links between people; the photos they appear in are found by their faces."
    },
    {
      "type": "location",
      "label": "Location",
      "category": "content",
      "root": "/archive/locations",
      "searchable": true,
      "plural": "Locations",
      "description": "A location under /archive/locations: its name, the address it was written down with and how that was geocoded, the people who lived there and the photos linked to it. Where it is on the map is its child named position, a point, circle or outline."
    },
    {
      "type": "device",
      "label": "Device",
      "category": "content",
      "root": "/archive/devices",
      "searchable": true,
      "plural": "Devices",
      "description": "A camera, phone or tracker, matched by make, model and serial number. Knows its time zone, so photos without one get their capture time right."
    },
    {
      "type": "media-region",
      "label": "Region",
      "category": "content",
      "description": "A box on a photo, kept under the photo's regions/ directory: a face the detector found, a box someone drew, or a tag imported from the old archive. It carries who is in it. A region that shows a usable face has the face's vector as a child named embedding, and only those take part in face recognition."
    },
    {
      "type": "album-profile",
      "label": "Album profile",
      "category": "content",
      "description": "A summary of a library album's members — their times, days, places, people and a few pictures that stand for how it looks — kept beside it as its .profile child, which staging matches suggested groups against."
    }
  ],
  "roots": [
    "/archive/people",
    "/archive/locations",
    "/archive/devices",
    "/archive/albums",
    "/archive/sources"
  ],
